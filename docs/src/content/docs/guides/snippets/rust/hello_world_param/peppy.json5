{
  peppy_schema: "node/v1",
  manifest: {
    name: "hello_world_param",
    tag: "v1",
    description: ["A node that publishes a greeting to the name that its parameter gives, with a count, every 3 seconds."],
  },
  interfaces: {
    topics: {
      emits: [
        {
          name: "message_stream",
          description: "Each greeting, as text.",
          qos_profile: "sensor_data",
          message_format: {
            message: "string"
          },
        }
      ],
    }
  },
  execution: {
    language: "rust",
    parameters: {
      name: "string",
    },
    build_cmd: [
      "cargo",
      "build",
      "--release"
    ],
    run_cmd: [
      "./target/release/hello_world_param"
    ]
  },
}