{
  peppy_schema: "nodes_v1",
  manifest: {
    name: "standalone",
    tag: "0.1.0",
  },
  interfaces: {},
  execution: {
    language: "rust",
    // A bunch of fake parameters required to start our node
    parameters: {
      device_path: "string",
      video: {
        frame_rate: "u16",
        resolution: {
          width: "u16",
          height: "u16",
        },
        encoding: "string",
      },
    },
    build_cmd: [
      "cargo",
      "build",
      "--release"
    ],
    run_cmd: [
      "./target/release/standalone"
    ]
  }
}