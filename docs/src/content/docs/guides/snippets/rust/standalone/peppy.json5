{
  schema_version: 2,
  manifest: {
    name: "standalone",
    tag: "0.1.0",
    language: "rust",
  },
  build: {
    add_cmd: [
      "cargo",
      "build",
      "--release"
    ],
    start_cmd: [
      "./target/release/standalone"
    ]
  },
  // A bunch of fake parameters required to start our node
  parameters: {
    device: {
      physical: "string",
      sim: "string",
      priority: "string"
    },
    video: {
      frame_rate: "u16",
      resolution: {
        width: "u16",
        height: "u16",
      },
      encoding: "string",
    },
  },
  interfaces: {}
}