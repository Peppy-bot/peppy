{
  schema_version: 1,
  manifest: {
    name: "standalone",
    tag: "0.1.0",
    language: "rust",
    add_cmd: [
      "cargo",
      "build",
      "--release"
    ],
    start_cmd: [
      "cargo",
      "run",
      "--release"
    ]
  },
  // A bunch of fake parameters required to start our node
  parameters: {
    device: {
      $type: "object",
      physical: "string",
      sim: "string",
      priority: "string"
    },
    video: {
      $type: "object",
      frame_rate: "u16",
      resolution: {
        $type: "object",
        width: "u16",
        height: "u16",
      },
      encoding: "string",
    },
  },
  interfaces: {}
}