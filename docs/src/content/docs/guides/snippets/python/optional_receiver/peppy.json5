{
  peppy_schema: "node/v1",
  manifest: {
    name: "optional_receiver",
    tag: "v1",
    description: ["A node that prints the greetings of a hello_world_param instance when a launcher links one, and runs without one."],
    depends_on: {
      nodes: [
        {
          name: "hello_world_param",
          tag: "v1",
          link_id: "greeter",
          cardinality: "zero_or_one",
        },
      ]
    },
  },
  interfaces: {
    topics: {
      consumes: [
        {
          link_id: "greeter",
          name: "message_stream",
        }
      ],
    }
  },
  execution: {
    language: "python",
    build_cmd: [
      "uv",
      "sync"
    ],
    run_cmd: [
      "uv",
      "run",
      "optional_receiver"
    ]
  },
}
