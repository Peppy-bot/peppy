{
  schema_version: 1,
  manifest: {
    name: "standalone",
    tag: "0.1.0",
  },
  interfaces: {},
  execution: {
    language: "python",
    // A bunch of fake parameters required to start our node
    parameters: {
      device: {
        physical: "string",
        sim: "string",
        priority: "string"
      },
      video: {
        frame_rate: "u16",
        resolution: {
          width: "u16",
          height: "u16",
        },
        encoding: "string",
      },
    },
    build_cmd: [
      "uv",
      "sync"
    ],
    start_cmd: [
      "uv",
      "run",
      "standalone"
    ]
  }
}