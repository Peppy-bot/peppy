{
  peppy_schema: "node/v1",
  manifest: {
    name: "standalone",
    tag: "v1",
    description: ["A node with no topic, service or action, which takes the parameters of a camera."],
  },
  interfaces: {},
  execution: {
    language: "python",
    // A bunch of fake parameters required to start our node
    parameters: {
      device_path: "string",
      video: {
        frame_rate: "u16",
        resolution: {
          width: "u16",
          height: "u16",
        },
        encoding: "string",
      },
    },
    build_cmd: [
      "uv",
      "sync"
    ],
    run_cmd: [
      "uv",
      "run",
      "standalone"
    ]
  }
}