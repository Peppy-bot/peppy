{
  schema_version: 1,
  manifest: {
    name: "hello_world_param",
    tag: "0.1.0",
  },
  interfaces: {
    topics: {
      emits: [
        {
          name: "message_stream",
          qos_profile: "sensor_data",
          message_format: {
            message: "string"
          },
        }
      ],
    }
  },
  runtime: {
    language: "python",
    parameters: {
      name: "string",
    },
    add_cmd: [
      "uv",
      "sync"
    ],
    start_cmd: [
      "uv",
      "run",
      "hello_world_param"
    ]
  },
}