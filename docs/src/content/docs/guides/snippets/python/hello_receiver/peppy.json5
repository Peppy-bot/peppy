{
  schema_version: 1,
  manifest: {
    name: "hello_receiver",
    tag: "0.1.0",
    language: "python",
  },
  process: {
    add_cmd: [
      "uv",
      "sync"
    ],
    start_cmd: [
      "uv",
      "run",
      "hello_receiver"
    ]
  },
  interfaces: {
    topics: {
      expects: [
        {
          id: "hello_world_param_subscriber", // subscriber_id, up to you to decide
          node: "hello_world_param", // Will look for that node name
          tag: "0.1.0", // On that particular tag/version
          name: "message_stream", // With this topic name
        }
      ],
    }
  }
}