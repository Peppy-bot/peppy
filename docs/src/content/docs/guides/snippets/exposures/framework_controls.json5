// An exposure whose one target names a daemon interface: `stack_copies:v1`,
// which the peppy daemon that started the server serves. No node implements
// it, so the target takes no `links`: the launcher gives it a scope, the
// robot options a client may add, the features of each, and the most robots
// of them on the stack.
{
  peppy_schema: "mcp_exposure/v1",
  manifest: { name: "framework_controls", tag: "v1" },

  server: {
    title: "Robot stack (peppy framework)",
    instructions: "Add robots to the stack and remove them. stack.list reports the robot options this stack offers with their features, the machines of the stack and the robots it can remove. A robot and each of its features run on a machine: a peppy daemon, named by its core node name.",
  },

  call_record: {
    tool: "stack.recent_calls",
    description: "List the last calls of this endpoint that could change the stack, newest first.",
    keep: 200,
  },

  targets: {
    stack: {
      // A daemon interface is compiled into peppy and is never pinned:
      // `daemon` takes a name and a tag, and no `sha256`.
      daemon: { name: "stack_copies", tag: "v1" },
      services: [
        {
          member: "list",
          tool: "stack.list",
          description: "Report the robot options this stack can add with their features, the machines of the stack and this stack's machine, the robots of these options on the stack with their features and machines, the most robots it holds, and the addition or removal of a robot that runs now.",
          operation: "read_only",
          deadline_ms: 5000,
        },
      ],
      actions: [
        {
          member: "join",
          tool: "stack.join",
          description: "Add a robot of option to the stack under name on the machine core_node, with the features it names, each on its own machine, and wait until its software runs on each of its machines.",
          operation: "long_running",
          progress_timeout_ms: 660000,
        },
        {
          member: "remove",
          tool: "stack.remove",
          description: "Remove a robot from the stack, and wait until its software has stopped.",
          operation: "long_running",
          progress_timeout_ms: 660000,
        },
      ],
    },
  },
}
