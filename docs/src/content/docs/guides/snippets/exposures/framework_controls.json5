// An exposure whose two targets name daemon interfaces: `stack_copies:v1`,
// the copies of the launch, and `fleet:v1`, the fleet of the stack and its
// halt. The peppy daemon of the coordinator serves them, and no node
// implements them, so the targets take no `links`: the launcher gives each a
// scope. The scope of `stack` gives the robot options a client may add, the
// features of each, and the most robots of them on the stack; the scope of
// `fleet` names the members its client may call.
{
  peppy_schema: "mcp_exposure/v1",
  manifest: { name: "framework_controls", tag: "v1" },

  server: {
    title: "Robot stack (peppy framework)",
    instructions: "Add robots to the stack and remove them. stack.list reports the robot options this stack offers with their features, the machines of the stack and the robots it can remove. A robot and each of its features run on a machine: a peppy daemon, named by its core node name.",
  },

  call_record: {
    tool: "stack.recent_calls",
    description: "List the last calls of this endpoint that could change the stack, newest first, each with its outcome, and the failure kind and message of a refused or failed call.",
    keep: 200,
  },

  targets: {
    stack: {
      // A daemon interface is compiled into peppy and is never pinned:
      // `daemon` takes a name and a tag, and no `sha256`.
      daemon: { name: "stack_copies", tag: "v1" },
      services: [
        {
          member: "list",
          tool: "stack.list",
          description: "Report the robot options this stack can add with their features, the machines of the stack and this stack's machine, the robots of these options on the stack with their features and machines, the most robots it holds, and the addition or removal of a robot that runs now.",
          operation: "read_only",
          deadline_ms: 5000,
        },
      ],
      actions: [
        {
          member: "join",
          tool: "stack.join",
          description: "Add a robot of option to the stack under name on the machine core_node, with the features it names, each on its own machine, and wait until its software runs on each of its machines.",
          operation: "long_running",
          progress_timeout_ms: 660000,
        },
        {
          member: "remove",
          tool: "stack.remove",
          description: "Remove a robot from the stack, and wait until its software has stopped.",
          operation: "long_running",
          progress_timeout_ms: 660000,
        },
      ],
    },
    fleet: {
      daemon: { name: "fleet", tag: "v1" },
      services: [
        {
          member: "list",
          tool: "fleet.list",
          description: "Report the robots of this stack with their software and their leases, and the halt of the stack.",
          operation: "read_only",
          deadline_ms: 5000,
        },
        {
          member: "halt",
          tool: "fleet.halt",
          description: "Halt the stack: end every lease, and refuse every move until fleet.clear_halt.",
          operation: "mutating",
          deadline_ms: 5000,
        },
        {
          member: "clear_halt",
          tool: "fleet.clear_halt",
          description: "Clear the halt of the stack. It starts nothing again.",
          operation: "mutating",
          deadline_ms: 5000,
        },
      ],
    },
  },
}
