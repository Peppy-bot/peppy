{
    schema_version: 1,
    manifest: {
        name: "my_first_node",
        tag: "0.1.0",
        add_cmd: [
            "cargo",
            "build",
            "--release"
        ],
        start_cmd: [
            "cargo",
            "run",
            "--release"
        ]
    },
    interfaces: {
        exposes: {
            topics: [
                {
                    name: "hello_world",
                    qos_profile: "sensor_data",
                    message_format: {
                        message: "string"
                    },
                }
            ],
        }
    }
}