// Deploying an exposure with a daemon target: the robots run as copies, and
// the framework's endpoint lets a client add and remove them.
//
//   peppy stack launch mcp_framework_controls
{
  peppy_schema: "launcher/v1",
  components: [
    {
      name: "robot",
      cardinality: "zero_or_more",
      options: {
        // Its fragment declares the own axis `brain`, whose option
        // `ai_brain_vla` deploys the brain's instance.
        openarm_sim: "robots/fragments/openarm_sim.json5",
        so101_sim: "robots/fragments/so101_sim.json5",
      },
    },
  ],
  deployments: [
    {
      source: { exposures: ["framework_controls:v1"] },
      instances: [
        {
          instance_id: "framework_controls_inst",
          arguments: { port: 8903 },
          // The daemon targets take no link. Each takes a scope, keyed by
          // the target's name. The instance has no `core_node`: an instance
          // that serves a daemon target runs on the coordinator.
          daemon_scopes: {
            // The members of fleet:v1 that the endpoint calls: a client
            // lists the fleet and halts the stack. Without `clear_halt`, the
            // endpoint serves no fleet.clear_halt, and the halt ends with
            // `peppy fleet clear-halt`.
            fleet: { members: ["list", "halt"] },
            stack: {
              max_copies: 4,
              options: [
                {
                  option: "openarm_sim",
                  // The robot model a robot of the option is, which a
                  // client reads before it adds one.
                  model: "openarm_v2",
                  description: "A simulated OpenArm v2 standing on the floor: two arms with grippers",
                  // A feature selects one option of one own axis of the
                  // option, here `brain=ai_brain_vla`. A client adds a robot
                  // with it, and names the machine of its part.
                  features: [
                    {
                      feature: "ai_brain",
                      axis: "brain",
                      option: "ai_brain_vla",
                      description: "An AI brain that finds items by words, then grabs and places them",
                    },
                  ],
                },
                {
                  option: "so101_sim",
                  model: "so101",
                  description: "A simulated SO-101 clamped on the edge of a table: one arm with a gripper",
                },
              ],
            },
          },
        },
      ],
    },
  ],
}
