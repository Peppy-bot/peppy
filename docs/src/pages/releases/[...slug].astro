---
import { getCollection } from 'astro:content';
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import HtmlContent from '../../components/HtmlContent.astro';
import { releaseSlugFromVersion } from '../../lib/releaseEntry.js';

export async function getStaticPaths() {
  const releases = await getCollection('releases');
  return releases.flatMap((release) => [
    {
      params: { slug: releaseSlugFromVersion(release.data.version) },
      props: { release },
    },
    {
      params: { slug: `v${release.data.version}` },
      props: { release },
    },
  ]);
}

const { release } = Astro.props;
const version = release.data.version;
const date = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
}).format(release.data.date);
---

<StarlightPage
  frontmatter={{
    title: `v${version}`,
    description: release.data.description,
  }}
>
  <article>
    <header>
      <p><em>{release.data.description}</em></p>
      <p><small>Released on {date}</small></p>
    </header>
    <HtmlContent html={release.body ?? ''} />
  </article>
  <p><a href="/reference/changelog/">View all releases</a></p>
</StarlightPage>
