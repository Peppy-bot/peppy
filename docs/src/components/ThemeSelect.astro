---
/**
 * Custom theme toggle button matching the landing page style.
 * Replaces Starlight's default dropdown with a simple sun/moon toggle.
 */
---

<starlight-theme-select>
	<button
		class="theme-toggle"
		type="button"
		aria-label={Astro.locals.t('themeSelect.accessibleLabel')}
	>
		<svg class="theme-toggle__icon theme-toggle__icon--sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
			<circle cx="12" cy="12" r="5"></circle>
			<line x1="12" y1="1" x2="12" y2="3"></line>
			<line x1="12" y1="21" x2="12" y2="23"></line>
			<line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
			<line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
			<line x1="1" y1="12" x2="3" y2="12"></line>
			<line x1="21" y1="12" x2="23" y2="12"></line>
			<line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
			<line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
		</svg>
		<svg class="theme-toggle__icon theme-toggle__icon--moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
			<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
		</svg>
	</button>
</starlight-theme-select>

<style>
	.theme-toggle {
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 0.5rem;
		background: transparent;
		border: 1px solid var(--sl-color-hairline);
		border-radius: 8px;
		color: var(--sl-color-text);
		cursor: pointer;
		transition: background 0.15s ease, border-color 0.15s ease;
	}

	.theme-toggle:hover {
		background: var(--sl-color-gray-5);
		border-color: var(--sl-color-gray-4);
	}

	.theme-toggle__icon {
		display: none;
	}

	/* Dark mode: show sun icon (click to switch to light) */
	.theme-toggle__icon--sun {
		display: block;
	}

	/* Light mode: show moon icon (click to switch to dark) */
	:global([data-theme='light']) .theme-toggle__icon--sun {
		display: none;
	}

	:global([data-theme='light']) .theme-toggle__icon--moon {
		display: block;
	}
</style>

<script>
	type Theme = 'dark' | 'light';

	/** Key in `localStorage` to store color theme preference at. */
	const storageKey = 'starlight-theme';

	/** Get the preferred system color scheme. */
	const getPreferredColorScheme = (): Theme =>
		matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';

	/** Load the user's preference from `localStorage`. */
	const loadTheme = (): Theme => {
		if (typeof localStorage !== 'undefined') {
			const stored = localStorage.getItem(storageKey);
			if (stored === 'light' || stored === 'dark') return stored;
		}
		return getPreferredColorScheme();
	};

	/** Store the user's preference in `localStorage`. */
	function storeTheme(theme: Theme): void {
		if (typeof localStorage !== 'undefined') {
			localStorage.setItem(storageKey, theme);
		}
	}

	/** Apply theme to document */
	function applyTheme(theme: Theme): void {
		document.documentElement.dataset.theme = theme;
	}

	/** Toggle between light and dark themes */
	function toggleTheme(): void {
		const current = document.documentElement.dataset.theme as Theme;
		const newTheme: Theme = current === 'light' ? 'dark' : 'light';
		applyTheme(newTheme);
		storeTheme(newTheme);
	}

	// React to changes in system color scheme when no preference is stored
	matchMedia('(prefers-color-scheme: light)').addEventListener('change', () => {
		if (typeof localStorage !== 'undefined' && !localStorage.getItem(storageKey)) {
			applyTheme(getPreferredColorScheme());
		}
	});

	class StarlightThemeSelect extends HTMLElement {
		constructor() {
			super();
			// Apply initial theme
			applyTheme(loadTheme());
			// Add click handler to toggle button
			this.querySelector('button')?.addEventListener('click', toggleTheme);
		}
	}
	customElements.define('starlight-theme-select', StarlightThemeSelect);
</script>
