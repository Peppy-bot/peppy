---
/*
 * Animated node graph of the openarm_v2_teleop_mujoco launcher, laid out as the
 * bimanual robot it brings up rather than as a left-to-right flow chart. The
 * eight circles are the eight instances the launcher declares, and the arrows
 * are the links between them:
 *
 *   commander_inst (the browser panel) streams targets down to backbone_inst,
 *   backbone_inst streams governed setpoints out to the four limb relays
 *   (left/right_arm_inst, left/right_grip_inst), each relay leads its matching
 *   limb inside sim_inst (the MuJoCo engine), and robot_init_inst gathers the
 *   four relays' readiness and reports it back up to the backbone.
 *
 * Node positions form a T-pose: panel on top, backbone as the torso, the arm
 * relays on the shoulder beam with their gripper relays below them, the
 * readiness aggregator on the spine between them, and the engine at the base. A
 * faint chassis (head housing, spine, torso plate, shoulder beam, forearms)
 * sits behind the nodes to sell the silhouette.
 *
 * The graph cannot be drawn without crossings: four relays each linking to the
 * same three hubs (backbone, aggregator, engine) contains K3,3, and the floor
 * for K3,4 is two crossings. This drawing sits at that floor. Getting there
 * costs the two backbone to gripper links their straight line: each curves out
 * around its arm, down the corridor between the arm and its label, and into the
 * gripper, which also reads as the command running down the arm to the hand.
 * The two crossings left are gripper readiness against arm engine link, one per
 * side. Moving a node without re-checking those routes puts crossings back.
 *
 * Deliberately not drawn: the commander's four observed_* links (it watches
 * each relay's measured state directly). They span the full height of the
 * graph and would bury the command path; the caption covers them instead. Keep
 * the node and link set in step with
 * launchers-hub/openarm/openarm_v2_teleop_mujoco.json5 if that launcher changes.
 */
---

<svg
	class="stack-graph"
	viewBox="0 -12 660 518"
	role="img"
	aria-label="Node graph of the openarm_v2_teleop_mujoco launcher, drawn as a bimanual robot. commander_inst, the browser control panel, sits at the top and streams commands down to backbone_inst, the coordinator. The backbone streams governed setpoints out to four limb relays: left_arm_inst and right_arm_inst on the shoulders, left_grip_inst and right_grip_inst below them. Each of the four relays leads its matching limb inside sim_inst, the MuJoCo engine at the base, and reports readiness to robot_init_inst on the spine, which reports back up to the backbone. Each pairing streams measured state back the other way, and the panel also observes the four relays."
>
	<defs>
		<radialGradient id="sgHaloViolet" cx="50%" cy="50%" r="50%">
			<stop offset="0%" style="stop-color: var(--graph-violet); stop-opacity: 0.32"></stop>
			<stop offset="100%" style="stop-color: var(--graph-violet); stop-opacity: 0"></stop>
		</radialGradient>
		<radialGradient id="sgHaloOrange" cx="50%" cy="50%" r="50%">
			<stop offset="0%" style="stop-color: var(--graph-orange); stop-opacity: 0.32"></stop>
			<stop offset="100%" style="stop-color: var(--graph-orange); stop-opacity: 0"></stop>
		</radialGradient>
		<radialGradient id="sgHaloCyan" cx="50%" cy="50%" r="50%">
			<stop offset="0%" style="stop-color: var(--graph-cyan); stop-opacity: 0.32"></stop>
			<stop offset="100%" style="stop-color: var(--graph-cyan); stop-opacity: 0"></stop>
		</radialGradient>
		<radialGradient id="sgHaloTeal" cx="50%" cy="50%" r="50%">
			<stop offset="0%" style="stop-color: var(--graph-teal); stop-opacity: 0.32"></stop>
			<stop offset="100%" style="stop-color: var(--graph-teal); stop-opacity: 0"></stop>
		</radialGradient>
		<radialGradient id="sgHaloGreen" cx="50%" cy="50%" r="50%">
			<stop offset="0%" style="stop-color: var(--graph-green); stop-opacity: 0.32"></stop>
			<stop offset="100%" style="stop-color: var(--graph-green); stop-opacity: 0"></stop>
		</radialGradient>
		<radialGradient id="sgHaloBlue" cx="50%" cy="50%" r="50%">
			<stop offset="0%" style="stop-color: var(--graph-blue); stop-opacity: 0.32"></stop>
			<stop offset="100%" style="stop-color: var(--graph-blue); stop-opacity: 0"></stop>
		</radialGradient>

		<marker id="sgArrowCommand" markerWidth="10" markerHeight="7" refX="9" refY="3.5" orient="auto">
			<polygon points="0 0, 10 3.5, 0 7" style="fill: var(--graph-orange-soft)"></polygon>
		</marker>
		<marker id="sgArrowReady" markerWidth="10" markerHeight="7" refX="9" refY="3.5" orient="auto">
			<polygon points="0 0, 10 3.5, 0 7" style="fill: var(--graph-green-soft)"></polygon>
		</marker>
		<marker id="sgArrowEngine" markerWidth="10" markerHeight="7" refX="9" refY="3.5" orient="auto">
			<polygon points="0 0, 10 3.5, 0 7" style="fill: var(--graph-blue-soft)"></polygon>
		</marker>
	</defs>

	<!-- Faint chassis behind the nodes: head housing, spine, torso plate,
	     shoulder beam, and a forearm down to each gripper. -->
	<g class="stack-graph__chassis" fill="none">
		<rect x="276" y="2" width="108" height="108" rx="26" stroke-width="2"></rect>
		<line x1="330" y1="112" x2="330" y2="424" stroke-width="14" stroke-linecap="round"></line>
		<line x1="200" y1="250" x2="460" y2="250" stroke-width="16" stroke-linecap="round"></line>
		<line x1="200" y1="250" x2="200" y2="358" stroke-width="13" stroke-linecap="round"></line>
		<line x1="460" y1="250" x2="460" y2="358" stroke-width="13" stroke-linecap="round"></line>
		<rect x="294" y="124" width="72" height="72" rx="16" stroke-width="2"></rect>
	</g>

	<!-- Command path: the panel's targets, then the backbone's governed setpoints.
	     The gripper links take the long way round their arm to keep the drawing
	     at the minimum two crossings. -->
	<g class="stack-graph__links stack-graph__links--command">
		<line x1="330" y1="88" x2="330" y2="124"></line>
		<line x1="304" y1="178" x2="230" y2="230"></line>
		<line x1="356" y1="178" x2="430" y2="230"></line>
		<path d="M303,175 C240,205 140,200 134,268 C131,298 146,304 174,332"></path>
		<path d="M357,175 C420,205 520,200 526,268 C529,298 514,304 486,332"></path>
	</g>

	<!-- Readiness: every relay reports its limb, the aggregator reports the robot. -->
	<g class="stack-graph__links stack-graph__links--ready">
		<line x1="230" y1="261" x2="296" y2="287"></line>
		<line x1="229" y1="345" x2="297" y2="315"></line>
		<line x1="430" y1="261" x2="364" y2="287"></line>
		<line x1="431" y1="345" x2="363" y2="315"></line>
		<line x1="330" y1="268" x2="330" y2="196"></line>
	</g>

	<!-- Engine links: each relay leads its own limb inside the MuJoCo engine. -->
	<g class="stack-graph__links stack-graph__links--engine">
		<line x1="219" y1="276" x2="308" y2="395"></line>
		<line x1="229" y1="372" x2="298" y2="408"></line>
		<line x1="441" y1="276" x2="352" y2="395"></line>
		<line x1="431" y1="372" x2="362" y2="408"></line>
	</g>

	<!-- commander_inst: the browser control panel -->
	<g class="stack-graph__node stack-graph__node--violet" transform="translate(330 56)">
		<g class="stack-graph__float" style="--bob-dur: 2.9s">
			<circle class="stack-graph__halo" r="36" fill="url(#sgHaloViolet)"></circle>
			<circle class="stack-graph__disc" r="28"></circle>
			<g class="stack-graph__icon">
				<rect x="-12" y="-10" width="24" height="20" rx="2.5"></rect>
				<path d="M-12,-4.5 H12"></path>
				<circle class="stack-graph__icon-fill" cx="-9" cy="-7.3" r="1"></circle>
				<path class="stack-graph__icon-dim" d="M-8,1 H8 M-8,6 H8"></path>
				<circle class="stack-graph__icon-fill stack-graph__slider" cx="-3" cy="1" r="2"></circle>
				<circle
					class="stack-graph__icon-fill stack-graph__slider stack-graph__slider--b"
					cx="4"
					cy="6"
					r="2"></circle>
			</g>
		</g>
		<text class="stack-graph__label" y="-46" text-anchor="middle">commander_inst</text>
	</g>

	<!-- backbone_inst: the coordinator running the self-collision governor -->
	<g class="stack-graph__node stack-graph__node--orange" transform="translate(330 160)">
		<g class="stack-graph__float" style="--bob-dur: 2.5s; --bob-delay: 0.4s">
			<circle class="stack-graph__halo" r="36" fill="url(#sgHaloOrange)" style="--halo-delay: 0.5s"
			></circle>
			<circle class="stack-graph__disc" r="28"></circle>
			<g class="stack-graph__icon">
				<rect x="-8" y="-10" width="16" height="20" rx="1.5"></rect>
				<path d="M-12,-6 H-8 M-12,-2 H-8 M-12,2 H-8 M-12,6 H-8"></path>
				<path d="M8,-6 H12 M8,-2 H12 M8,2 H12 M8,6 H12"></path>
				<circle cx="0" cy="-5.5" r="2"></circle>
				<circle class="stack-graph__icon-fill stack-graph__blink" cx="0" cy="3.5" r="1.6"></circle>
			</g>
		</g>
		<text class="stack-graph__label" x="42" y="4" text-anchor="start">backbone_inst</text>
	</g>

	<!-- left_arm_inst: engine-agnostic arm relay -->
	<g class="stack-graph__node stack-graph__node--cyan" transform="translate(200 250)">
		<g class="stack-graph__float" style="--bob-dur: 2.3s; --bob-delay: 0.9s">
			<circle class="stack-graph__halo" r="36" fill="url(#sgHaloCyan)" style="--halo-delay: 0.9s"
			></circle>
			<circle class="stack-graph__disc" r="28"></circle>
			<g class="stack-graph__icon" transform="translate(-2 -1)">
				<path d="M-8,11 H8" stroke-width="2"></path>
				<path d="M-5,11 L-3,7 L3,7 L5,11 Z" stroke-width="1.3" stroke-linejoin="round"></path>
				<circle cx="0" cy="7" r="2.4"></circle>
				<path d="M0,7 V-2" stroke-width="2.6"></path>
				<circle cx="0" cy="-2" r="2.1"></circle>
				<path d="M0,-2 L8,-4" stroke-width="2.4"></path>
				<circle cx="8" cy="-4" r="1.6" stroke-width="1.3"></circle>
				<path d="M8,-4 L11,-5.5 L11.6,-7.6 M8,-4 L11,-2.5 L11.6,-0.4" stroke-width="1.3"></path>
			</g>
		</g>
		<text class="stack-graph__label" x="-88" y="5" text-anchor="end">left_arm_inst</text>
	</g>

	<!-- right_arm_inst: the same relay for the other arm -->
	<g class="stack-graph__node stack-graph__node--cyan" transform="translate(460 250)">
		<g class="stack-graph__float" style="--bob-dur: 2.7s; --bob-delay: 0.2s">
			<circle class="stack-graph__halo" r="36" fill="url(#sgHaloCyan)" style="--halo-delay: 0.3s"
			></circle>
			<circle class="stack-graph__disc" r="28"></circle>
			<g class="stack-graph__icon" transform="translate(2 -1) scale(-1 1)">
				<path d="M-8,11 H8" stroke-width="2"></path>
				<path d="M-5,11 L-3,7 L3,7 L5,11 Z" stroke-width="1.3" stroke-linejoin="round"></path>
				<circle cx="0" cy="7" r="2.4"></circle>
				<path d="M0,7 V-2" stroke-width="2.6"></path>
				<circle cx="0" cy="-2" r="2.1"></circle>
				<path d="M0,-2 L8,-4" stroke-width="2.4"></path>
				<circle cx="8" cy="-4" r="1.6" stroke-width="1.3"></circle>
				<path d="M8,-4 L11,-5.5 L11.6,-7.6 M8,-4 L11,-2.5 L11.6,-0.4" stroke-width="1.3"></path>
			</g>
		</g>
		<text class="stack-graph__label" x="88" y="5" text-anchor="start">right_arm_inst</text>
	</g>

	<!-- left_grip_inst: gripper relay, mirroring the arm relay over gripper_link -->
	<g class="stack-graph__node stack-graph__node--teal" transform="translate(200 358)">
		<g class="stack-graph__float" style="--bob-dur: 2.6s; --bob-delay: 1.2s">
			<circle class="stack-graph__halo" r="36" fill="url(#sgHaloTeal)" style="--halo-delay: 1.2s"
			></circle>
			<circle class="stack-graph__disc" r="28"></circle>
			<g class="stack-graph__icon">
				<path d="M0,10 V3" stroke-width="2.4"></path>
				<circle cx="0" cy="2" r="2.2"></circle>
				<path
					d="M-1.6,0.6 L-5.5,-3 L-6.4,-9 M1.6,0.6 L5.5,-3 L6.4,-9"
					stroke-width="1.8"
					stroke-linejoin="round"></path>
			</g>
		</g>
		<text class="stack-graph__label" x="-88" y="5" text-anchor="end">left_grip_inst</text>
	</g>

	<!-- right_grip_inst: the same relay for the other gripper -->
	<g class="stack-graph__node stack-graph__node--teal" transform="translate(460 358)">
		<g class="stack-graph__float" style="--bob-dur: 2.4s; --bob-delay: 0.6s">
			<circle class="stack-graph__halo" r="36" fill="url(#sgHaloTeal)" style="--halo-delay: 0.7s"
			></circle>
			<circle class="stack-graph__disc" r="28"></circle>
			<g class="stack-graph__icon">
				<path d="M0,10 V3" stroke-width="2.4"></path>
				<circle cx="0" cy="2" r="2.2"></circle>
				<path
					d="M-1.6,0.6 L-5.5,-3 L-6.4,-9 M1.6,0.6 L5.5,-3 L6.4,-9"
					stroke-width="1.8"
					stroke-linejoin="round"></path>
			</g>
		</g>
		<text class="stack-graph__label" x="88" y="5" text-anchor="start">right_grip_inst</text>
	</g>

	<!-- robot_init_inst: ready once every limb's physics is live -->
	<g class="stack-graph__node stack-graph__node--green" transform="translate(330 300)">
		<g class="stack-graph__float" style="--bob-dur: 3.1s; --bob-delay: 0.8s">
			<circle class="stack-graph__halo" r="36" fill="url(#sgHaloGreen)" style="--halo-delay: 1.4s"
			></circle>
			<circle class="stack-graph__disc" r="28"></circle>
			<g class="stack-graph__icon">
				<circle cx="0" cy="0" r="9"></circle>
				<path d="M-4.4,0.2 L-1.4,3.4 L4.8,-3.6" stroke-width="1.8" stroke-linejoin="round"></path>
				<circle class="stack-graph__icon-fill stack-graph__tick" cx="0" cy="-13" r="1.7"></circle>
				<circle
					class="stack-graph__icon-fill stack-graph__tick"
					cx="13"
					cy="0"
					r="1.7"
					style="--tick-delay: 0.35s"></circle>
				<circle
					class="stack-graph__icon-fill stack-graph__tick"
					cx="0"
					cy="13"
					r="1.7"
					style="--tick-delay: 0.7s"></circle>
				<circle
					class="stack-graph__icon-fill stack-graph__tick"
					cx="-13"
					cy="0"
					r="1.7"
					style="--tick-delay: 1.05s"></circle>
			</g>
		</g>
		<text class="stack-graph__label" y="48" text-anchor="middle">robot_init_inst</text>
	</g>

	<!-- sim_inst: the MuJoCo engine every relay leads -->
	<g class="stack-graph__node stack-graph__node--blue" transform="translate(330 424)">
		<g class="stack-graph__float" style="--bob-dur: 3.4s; --bob-delay: 0.3s">
			<circle class="stack-graph__halo" r="36" fill="url(#sgHaloBlue)" style="--halo-delay: 0.2s"
			></circle>
			<circle class="stack-graph__disc" r="28"></circle>
			<g class="stack-graph__icon">
				<path d="M0,-11.5 L10,-5.8 L10,5.8 L0,11.5 L-10,5.8 L-10,-5.8 Z" stroke-linejoin="round"
				></path>
				<path d="M0,0 V-11.5 M0,0 L10,5.8 M0,0 L-10,5.8" stroke-width="1.2"></path>
				<circle class="stack-graph__icon-fill stack-graph__particle" cx="0" cy="-6.5" r="1.5"
				></circle>
			</g>
		</g>
		<text class="stack-graph__label" y="48" text-anchor="middle">sim_inst</text>
	</g>

	<!-- Legend. Each class carries its own dash pattern as well as its own color,
	     so the three link kinds stay apart without relying on hue. -->
	<g class="stack-graph__legend">
		<g class="stack-graph__links stack-graph__links--command">
			<line x1="18" y1="22" x2="44" y2="22"></line>
		</g>
		<text x="52" y="26">commands</text>
		<g class="stack-graph__links stack-graph__links--ready">
			<line x1="18" y1="44" x2="44" y2="44"></line>
		</g>
		<text x="52" y="48">readiness</text>
		<g class="stack-graph__links stack-graph__links--engine">
			<line x1="18" y1="66" x2="44" y2="66"></line>
		</g>
		<text x="52" y="70">engine links</text>
	</g>

	<text class="stack-graph__caption" x="330" y="492" text-anchor="middle"
		>Each pairing streams measured state back the other way; the panel also observes the four
		relays.</text
	>
</svg>

<style>
	.stack-graph {
		display: block;
		width: 100%;
		height: auto;

		--graph-surface: #111a2e;
		--graph-chassis: #5c6a86;
		--graph-label: #94a2bd;
		--graph-violet: #8b5cf6;
		--graph-violet-soft: #a78bfa;
		--graph-orange: #f97316;
		--graph-orange-soft: #fb923c;
		--graph-cyan: #06b6d4;
		--graph-cyan-soft: #22d3ee;
		--graph-teal: #14b8a6;
		--graph-teal-soft: #2dd4bf;
		--graph-green: #22c55e;
		--graph-green-soft: #4ade80;
		--graph-blue: #3b82f6;
		--graph-blue-soft: #60a5fa;
	}

	/* Light mode needs the darker end of each ramp to stay readable on the pale
	   page background, and a light disc fill so the icons keep their contrast. */
	:global([data-theme='light']) .stack-graph {
		/* White, not the page background: the graph also sits inside a note aside,
		   whose tint would otherwise show the disc as a muddy gray. */
		--graph-surface: #ffffff;
		--graph-chassis: #94a2bd;
		--graph-label: #5c6a86;
		--graph-violet: #7c3aed;
		--graph-violet-soft: #6d28d9;
		--graph-orange: #ea580c;
		--graph-orange-soft: #c2410c;
		--graph-cyan: #0891b2;
		--graph-cyan-soft: #0e7490;
		--graph-teal: #0d9488;
		--graph-teal-soft: #0f766e;
		--graph-green: #16a34a;
		--graph-green-soft: #15803d;
		--graph-blue: #2563eb;
		--graph-blue-soft: #1d4ed8;
	}

	.stack-graph__chassis {
		stroke: var(--graph-chassis);
		stroke-opacity: 0.22;
	}

	.stack-graph__links line,
	.stack-graph__links path {
		fill: none;
		stroke-width: 2;
		stroke-linecap: round;
		animation: sg-flow var(--flow-dur, 1.1s) linear infinite;
	}

	@keyframes sg-flow {
		to {
			stroke-dashoffset: var(--flow-end, -30);
		}
	}

	.stack-graph__links--command line,
	.stack-graph__links--command path {
		stroke: var(--graph-orange-soft);
		stroke-dasharray: 9 6;
		marker-end: url(#sgArrowCommand);
		--flow-end: -30;
	}

	.stack-graph__links--ready line,
	.stack-graph__links--ready path {
		stroke: var(--graph-green-soft);
		stroke-width: 1.6;
		stroke-opacity: 0.75;
		stroke-dasharray: 2 6;
		marker-end: url(#sgArrowReady);
		--flow-dur: 1.6s;
		--flow-end: -24;
	}

	.stack-graph__links--engine line,
	.stack-graph__links--engine path {
		stroke: var(--graph-blue-soft);
		stroke-dasharray: 5 5;
		marker-end: url(#sgArrowEngine);
		--flow-dur: 1.3s;
		--flow-end: -30;
	}

	.stack-graph__disc {
		fill: var(--graph-surface);
		stroke-width: 2;
	}

	.stack-graph__icon {
		fill: none;
		stroke-width: 1.5;
		stroke-linecap: round;
	}

	.stack-graph__icon-fill {
		stroke: none;
	}

	.stack-graph__icon-dim {
		stroke-opacity: 0.55;
	}

	.stack-graph__node--violet .stack-graph__disc {
		stroke: var(--graph-violet);
	}
	.stack-graph__node--violet .stack-graph__icon {
		stroke: var(--graph-violet-soft);
	}
	.stack-graph__node--violet .stack-graph__icon-fill {
		fill: var(--graph-violet-soft);
	}

	.stack-graph__node--orange .stack-graph__disc {
		stroke: var(--graph-orange);
	}
	.stack-graph__node--orange .stack-graph__icon {
		stroke: var(--graph-orange-soft);
	}
	.stack-graph__node--orange .stack-graph__icon-fill {
		fill: var(--graph-orange-soft);
	}

	.stack-graph__node--cyan .stack-graph__disc {
		stroke: var(--graph-cyan);
	}
	.stack-graph__node--cyan .stack-graph__icon {
		stroke: var(--graph-cyan-soft);
	}
	.stack-graph__node--cyan .stack-graph__icon-fill {
		fill: var(--graph-cyan-soft);
	}

	.stack-graph__node--teal .stack-graph__disc {
		stroke: var(--graph-teal);
	}
	.stack-graph__node--teal .stack-graph__icon {
		stroke: var(--graph-teal-soft);
	}
	.stack-graph__node--teal .stack-graph__icon-fill {
		fill: var(--graph-teal-soft);
	}

	.stack-graph__node--green .stack-graph__disc {
		stroke: var(--graph-green);
	}
	.stack-graph__node--green .stack-graph__icon {
		stroke: var(--graph-green-soft);
	}
	.stack-graph__node--green .stack-graph__icon-fill {
		fill: var(--graph-green-soft);
	}

	.stack-graph__node--blue .stack-graph__disc {
		stroke: var(--graph-blue);
	}
	.stack-graph__node--blue .stack-graph__icon {
		stroke: var(--graph-blue-soft);
	}
	.stack-graph__node--blue .stack-graph__icon-fill {
		fill: var(--graph-blue-soft);
	}

	.stack-graph__label {
		fill: var(--graph-label);
