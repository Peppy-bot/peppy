{# Segment 4. A node is a regular project of its language. It runs alone in
   standalone mode, and it tests alone with generated mocks. #}
{% from "_parts.html.j2" import backdrop, header, problem_scene, rail, term_card, code_window, node, wire %}
{% set id = segment.id %}
{% set tools = screen.comparisons.tools %}
<template>
  <style>
    #root {
      position: absolute;
      inset: 0;
    }
    {# The tools of one node: one line for each task, with ROS 2 and Peppy
       side by side. #}
    .{{ id }}-table {
      display: grid;
      grid-template-columns: 170px 1.15fr 1fr;
      column-gap: 40px;
      margin-top: 22px;
    }
    .{{ id }}-head {
      padding-bottom: 6px;
    }
    .{{ id }}-cell {
      padding: 20px 0;
      border-top: 2px solid var(--line);
      font-size: 32px;
      line-height: 42px;
    }
    .{{ id }}-cell.steps-row-name {
      font-size: 28px;
    }
    .{{ id }}-other {
      padding-top: 4px;
    }
    {# A scene of code: the code above its diagram. #}
    .{{ id }}-code-scene {
      gap: 56px;
    }
    .{{ id }}-code-scene .code-window {
      align-self: stretch;
    }
    .{{ id }}-diagram {
      align-self: stretch;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .{{ id }}-diagram.is-near {
      justify-content: center;
      gap: 220px;
    }
    .{{ id }}-stack {
      display: flex;
      flex-direction: column;
      gap: 28px;
      padding: 48px 40px 40px;
    }
    .{{ id }}-diagram .node {
      width: 330px;
    }
    .{{ id }}-mock {
      border-style: dashed;
    }
    .{{ id }}-mock-tag {
      position: absolute;
      right: 22px;
      top: -25px;
    }
    .{{ id }}-sync-note {
      align-self: stretch;
      margin-top: -16px;
    }
  </style>
  <div id="root" data-composition-id="{{ id }}" data-width="1920" data-height="1080">
    <div id="{{ id }}-stage" class="stage">
      {{ backdrop(id) }}
      {{ header(segment, act) }}
      <div id="{{ id }}-content">
      {{ problem_scene(id, segment, screen.problem) }}

      {# The tools that build, run and test one node. #}
      <div id="{{ id }}-tools" class="steps-scene">
        <div class="steps">
          <div class="card-kind">{{ labels.comparison }}</div>
          <div class="steps-title">{{ tools.title | rich }}</div>
          <div class="{{ id }}-table">
            <span></span>
            <div id="{{ id }}-head-ros2" class="{{ id }}-head">
              <span class="steps-side-name is-ros2">{{ labels.ros2 }}</span>
              <div class="steps-summary">{{ tools.ros2_summary | rich }}</div>
            </div>
            <div id="{{ id }}-head-peppy" class="{{ id }}-head">
              <span class="steps-side-name is-peppy">{{ labels.peppy }}</span>
              <div class="steps-summary">{{ tools.peppy_summary | rich }}</div>
            </div>
            {% for row in tools.rows %}
            <span class="steps-row-name {{ id }}-cell">{{ row }}</span>
            <div class="{{ id }}-cell"><span id="{{ id }}-ros2-{{ loop.index }}">{{ tools.ros2[loop.index0] | rich }}</span></div>
            <div class="{{ id }}-cell"><span id="{{ id }}-peppy-{{ loop.index }}">{{ tools.peppy[loop.index0] | rich }}</span></div>
            {% endfor %}
            <span></span>
            <span></span>
            <div id="{{ id }}-other" class="note {{ id }}-other">{{ screen.other_tools | rich }}</div>
          </div>
          <div class="steps-note">{{ tools.note | rich }}</div>
        </div>
      </div>

      <div id="{{ id }}-concept" class="scene">
        {# Standalone mode: the node is a regular program, and it communicates
           with the nodes of the stack. #}
        <div id="{{ id }}-run" class="zone is-centered {{ id }}-code-scene">
          {{ code_window(id + "-run-code", screen.standalone.code) }}
          <div class="{{ id }}-diagram">
            {{ node(id + "-run-node", screen.standalone.node, "laptop") }}
            <div id="{{ id }}-stack" class="frame {{ id }}-stack">
              <span class="frame-name" data-layout="over">{{ screen.standalone.stack }}</span>
              {% for name, icon_name in [(screen.standalone.nodes[0], "camera"), (screen.standalone.nodes[1], "arm")] %}
              {{ node(id + "-stack-node-" ~ loop.index, name, icon_name) }}
              {% endfor %}
            </div>
          </div>
        </div>
        {# A test of the node alone: a generated mock is the camera. #}
        <div id="{{ id }}-test" class="zone is-centered {{ id }}-code-scene">
          {{ code_window(id + "-test-code", screen.test.code) }}
          <div class="{{ id }}-diagram is-near">
            {% call node(id + "-mock", screen.test.camera, "camera", id + "-mock") %}
            <span class="pill {{ id }}-mock-tag" data-layout="over">{{ screen.test.mock }}</span>
            {% endcall %}
            {{ node(id + "-test-node", screen.test.node, "laptop") }}
          </div>
          <div id="{{ id }}-sync-note" class="note {{ id }}-sync-note">{{ screen.sync_note | rich }}</div>
        </div>
        <svg class="wires" viewBox="0 0 1920 1080">
          {{ wire(id + "-talks-1") }}
          {{ wire(id + "-talks-2") }}
          {{ wire(id + "-publishes") }}
        </svg>
        <div id="{{ id }}-message" class="dot" data-layout="free"></div>
        {{ rail(id, screen, [
          ["standalone", screen.cards.standalone.term, term_card(id + "-card-standalone", screen.cards.standalone)],
          ["mock", screen.cards.mock.term, term_card(id + "-card-mock", screen.cards.mock)],
        ]) }}
      </div>

      </div>
    </div>
  </div>
  <script>
    (function () {
      const ID = "#{{ id }}";
      const at = {{ at | tojson }};
      const DURATION = {{ duration }};
      const tl = gsap.timeline({ paused: true });
      const ROWS = {{ tools.rows | length }};

      Motion.connect(ID + "-talks-1", [ID + "-run-node", "right", -16], [ID + "-stack-node-1", "left"], { gap: 6 });
      Motion.connect(ID + "-talks-2", [ID + "-run-node", "right", 16], [ID + "-stack-node-2", "left"], { gap: 6 });
      Motion.connect(ID + "-publishes", [ID + "-mock", "right"], [ID + "-test-node", "left"], { gap: 6 });

      const testStart = at.mocks.start - 0.3;
      Motion.chapter(tl, ID, {
        duration: DURATION,
        problem: [0.3, at.regular_project.start - 0.2],
        concept: at.standalone.start - 0.3,
        terms: [
          ["standalone", at.standalone.start + 0.2, testStart],
          ["mock", at.mocks.start + 0.2, at.benefit.start - 0.1],
        ],
        benefit: at.benefit.start,
        ros2: at.benefit.start + 1.2,
      });

      // A node is a regular project: the side of Peppy comes in with the
      // voice, one line for each task.
      Motion.showBetween(tl, ID + "-tools", at.regular_project.start - 0.3, at.standalone.start - 0.2);
      Motion.show(tl, ID + "-head-peppy", at.regular_project.start + 0.2, Motion.appears);
      Motion.show(tl, ID + "-peppy-1", Motion.within(at.regular_project, 0.6), Motion.fromSide);
      [0.52, 0.62, 0.72].forEach((share, index) => Motion.show(tl, ID + "-peppy-" + (index + 2), Motion.within(at.your_tools, share), Motion.fromSide));
      Motion.show(tl, ID + "-other", at.your_tools.end, Motion.appears);
      // ROS 2 has a build system of its own.
      Motion.show(tl, ID + "-head-ros2", at.ros2_tools.start + 0.2, Motion.appears);
      for (let row = 1; row <= ROWS; row += 1) {
        Motion.show(tl, ID + "-ros2-" + row, Motion.within(at.ros2_tools, 0.45) + row * 0.3, Motion.fromSide);
      }

      // Standalone mode: the node runs as a regular program, and it
      // communicates with the nodes of the stack.
      Motion.show(tl, ID + "-run-code", at.standalone.start - 0.1);
      Motion.show(tl, ID + "-run-node", at.standalone.start + 0.4, Motion.grows);
      Motion.focusLines(tl, ID + "-run-code", [4], Motion.within(at.standalone, 0.1));
      Motion.focusLines(tl, ID + "-run-code", [5], Motion.within(at.standalone, 0.36));
      Motion.pulse(tl, ID + "-run-node", Motion.within(at.standalone, 0.36));
      const talks = Motion.within(at.standalone, 0.7);
      Motion.show(tl, ID + "-stack", talks - 0.5);
      [1, 2].forEach((number, index) => Motion.drawArrow(tl, ID + "-talks-" + number, talks + index * 0.25, 0.5));
      Motion.focusLines(tl, ID + "-run-code", [], at.standalone.end);

      // A test of the node alone: the generated mock is the camera, and it
      // gives the node a message.
      Motion.hide(tl, [ID + "-run", ID + "-talks-1", ID + "-talks-1-head", ID + "-talks-2", ID + "-talks-2-head"], testStart + 0.2);
      Motion.show(tl, ID + "-test-code", testStart + 0.2);
      Motion.show(tl, ID + "-test-node", testStart + 0.5, Motion.grows);
      Motion.show(tl, ID + "-mock", Motion.within(at.mocks, 0.55), Motion.grows);
      Motion.show(tl, ID + "-sync-note", Motion.within(at.mocks, 0.8), Motion.appears);
      Motion.focusLines(tl, ID + "-test-code", [1, 2], Motion.within(at.mocks, 0.8));
      Motion.focusLines(tl, ID + "-test-code", [3, 4, 5], at.one_test.start + 0.2);
      Motion.drawArrow(tl, ID + "-publishes", at.one_test.start + 0.3, 0.5);
      Motion.follow(tl, ID + "-message", ID + "-publishes", at.one_test.start + 0.9, 0.7, 2);
      Motion.pulse(tl, ID + "-test-node", at.one_test.start + 2.3);
      Motion.focusLines(tl, ID + "-test-code", [6, 7], Motion.within(at.one_test, 0.62));
      Motion.focusLines(tl, ID + "-test-code", [], at.benefit.start - 0.2);

      window.__timelines["{{ id }}"] = tl;
    })();
  </script>
</template>
