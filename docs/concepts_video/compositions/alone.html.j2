{# Segment 4. A node is a regular project of its language. It runs alone, in
   standalone mode, and it tests alone, with generated mocks. #}
{% from "_parts.html.j2" import chapter, comparison_card, code_window %}
{% set id = segment.id %}
{# The two code windows have the same place. `line_top` is the top of the first
   line of a window, below its padding, and a line is `line_height` high. #}
{% set code_top = 384 %}
{% set line_top = code_top + 26 %}
{% set line_height = 42 %}
{% set code_right = 96 + 1108 %}
{# The nodes at the right of the code. The wire of the standalone node goes
   out of the window at its line 5, the line that runs the node. The wire of
   the mock comes in at the lines 3 to 5, which publish a message. #}
{% set nodes_left = 1400 %}
{% set run_wire = line_top + 4 * line_height + line_height // 2 %}
{% set mock_wire = line_top + 3 * line_height + line_height // 2 %}

{# The comparison of the tools of one node: one row for each task, with what
   ROS 2 uses and what Peppy uses. Each row is a grid with the same columns.
   The head of a side has the id `<id>-<side>-head`, a row name
   `<id>-row-<n>`, and a cell `<id>-<side>-<n>`. #}
{% macro tools_table(id, comparison, other_tools) %}
<div id="{{ id }}" class="steps">
  <div class="card-kind" style="color: var(--ros2)">{{ labels.comparison }}</div>
  <div class="steps-title">{{ comparison.title | rich }}</div>
  <div class="{{ id }}-row">
    {% for side, name in [("ros2", labels.ros2), ("peppy", labels.peppy)] %}
    <div id="{{ id }}-{{ side }}-head" class="steps-side is-{{ side }}"><span class="steps-side-name">{{ name }}</span><div class="steps-summary">{{ comparison[side + "_summary"] | rich }}</div></div>
    {% endfor %}
  </div>
  {% for row in comparison.rows %}
  <div class="{{ id }}-row">
    <div id="{{ id }}-row-{{ loop.index }}" class="steps-row-name">{{ row }}</div>
    <div id="{{ id }}-ros2-{{ loop.index }}" class="{{ id }}-cell is-ros2">{{ comparison.ros2[loop.index0] | rich }}</div>
    <div id="{{ id }}-peppy-{{ loop.index }}" class="{{ id }}-cell is-peppy">{{ comparison.peppy[loop.index0] | rich }}</div>
  </div>
  {% endfor %}
  <div class="{{ id }}-row"><div id="{{ id }}-other" class="{{ id }}-cell is-other">{{ other_tools | rich }}</div></div>
  <div id="{{ id }}-note" class="steps-note">{{ comparison.note | rich }}</div>
</div>
{% endmacro %}
<template>
  <style>
    #root {
      position: absolute;
      inset: 0;
    }
    .{{ id }}-tools-row {
      display: grid;
      grid-template-columns: 170px 1fr 1fr;
      column-gap: 40px;
      padding: 16px 0;
      font-size: 30px;
      line-height: 40px;
    }
    .{{ id }}-tools-row + .{{ id }}-tools-row {
      border-top: 2px solid var(--line);
    }
    .{{ id }}-tools-row .steps-side.is-ros2 {
      grid-column: 2;
    }
    .{{ id }}-tools-row .steps-side.is-peppy,
    .{{ id }}-tools-cell.is-other {
      grid-column: 3;
    }
    .{{ id }}-tools-row .steps-summary {
      margin-bottom: 0;
    }
    #{{ id }}-tools code,
    #{{ id }}-sync-note code,
    #{{ id }}-compare-mocks code {
      font-size: 28px;
    }
    .{{ id }}-tools-cell.is-ros2 code {
      color: var(--ros2);
    }
    .{{ id }}-tools-cell.is-peppy code {
      color: var(--peppy);
    }
    .{{ id }}-tools-cell.is-other {
      font-size: 28px;
      color: var(--ink-dim);
    }
    .{{ id }}-group {
      position: absolute;
      left: 0;
      top: 0;
      width: 1920px;
      height: 1080px;
    }
    .{{ id }}-label {
      position: absolute;
      left: 96px;
      top: {{ code_top - 132 }}px;
      width: 800px;
      font-size: 34px;
      font-weight: 500;
      line-height: 46px;
      color: var(--ink);
    }
    #{{ id }}-standalone-code,
    #{{ id }}-test-code {
      left: 96px;
      top: {{ code_top }}px;
      width: {{ code_right - 96 }}px;
    }
    .{{ id }}-sync-note {
      left: 96px;
      top: {{ line_top + 7 * line_height + 54 }}px;
      width: 1010px;
      text-wrap: balance;
    }
    .{{ id }}-mock {
      border-style: dashed;
    }
    .{{ id }}-mock-tag {
      position: absolute;
      right: 18px;
      top: -24px;
      padding: 0 14px;
      border: 2px solid var(--data);
      border-radius: 10px;
      background: var(--ground);
      font-size: 28px;
      line-height: 38px;
      color: var(--data);
    }
  </style>
  <div id="root" data-composition-id="{{ id }}" data-width="1920" data-height="1080">
    <div id="{{ id }}-stage" class="stage">
      {{ chapter(number, segment.chapter) -}}
      <div id="{{ id }}-content">
      {{ tools_table(id + "-tools", screen.comparisons.tools, screen.other_tools) -}}
      {# Standalone mode: the node is a regular program, and it communicates
         with the nodes of the stack. #}
      <div id="{{ id }}-standalone" class="{{ id }}-group">
        <div class="{{ id }}-label">{{ screen.standalone.label }}</div>
        {{ code_window(id + "-standalone-code", screen.standalone.code) -}}
      </div>
      <div id="{{ id }}-stack" class="{{ id }}-group">
        <div class="machine" style="left: 1250px; top: {{ run_wire - 106 }}px; width: 574px; height: 372px"><span class="machine-name">{{ screen.standalone.stack }}</span></div>
        <svg class="wires" viewBox="0 0 1920 1080">
          <path id="{{ id }}-talks" class="wire" pathLength="1" d="M {{ code_right + 2 }} {{ run_wire }} H {{ nodes_left - 4 }}" />
          <path id="{{ id }}-talks-more" class="wire" pathLength="1" d="M 1320 {{ run_wire }} V {{ run_wire + 136 }} Q 1320 {{ run_wire + 160 }} 1344 {{ run_wire + 160 }} H {{ nodes_left - 4 }}" />
        </svg>
        {% for node in screen.standalone.nodes %}
        <div class="node" style="left: {{ nodes_left }}px; top: {{ run_wire - 46 + loop.index0 * 160 }}px; width: 300px">{{ node }}</div>
        {% endfor %}
      </div>
      {# One test: a generated mock publishes the message of the camera. #}
      <div id="{{ id }}-test" class="{{ id }}-group">
        <div class="{{ id }}-label">{{ screen.test.label }}</div>
        {{ code_window(id + "-test-code", screen.test.code) -}}
        <div id="{{ id }}-sync-note" class="note {{ id }}-sync-note">{{ screen.sync_note | rich }}</div>
        <svg class="wires" viewBox="0 0 1920 1080">
          <path id="{{ id }}-publishes" class="wire" pathLength="1" d="M {{ nodes_left }} {{ mock_wire }} H {{ code_right + 18 }}" /><polygon id="{{ id }}-publishes-head" class="wire-head" points="{{ code_right + 20 }},{{ mock_wire - 10 }} {{ code_right + 4 }},{{ mock_wire }} {{ code_right + 20 }},{{ mock_wire + 10 }}" />
        </svg>
        <div id="{{ id }}-mock" class="node {{ id }}-mock" style="left: {{ nodes_left }}px; top: {{ mock_wire - 46 }}px; width: 300px">{{ screen.standalone.nodes[0] }}<span class="{{ id }}-mock-tag">{{ screen.test.mock }}</span></div>
      </div>
      <div id="{{ id }}-dot-1" class="dot"></div><div id="{{ id }}-dot-2" class="dot"></div>
      {{ comparison_card(id + "-compare-mocks", screen.comparisons.mocks) -}}
      </div>
    </div>
  </div>
  <script>
    (function () {
      const ID = "#{{ id }}";
      const at = {{ at | tojson }};
      const DURATION = {{ duration }};
      const tl = gsap.timeline({ paused: true });
      const fades = { from: { opacity: 0, y: 0 } };
      // The two ends of the wire between the code and the nodes at its right.
      const atCode = (y) => ({ x: {{ code_right + 12 }}, y });
      const atNodes = (y) => ({ x: {{ nodes_left - 12 }}, y });
      Motion.endSegment(tl, ID + "-content", DURATION);
      // The tools of one node: the names of the rows, then the side of
      // Peppy, with one cell for each part of the voice.
      const TOOLS = ID + "-tools";
      const ROWS = [1, 2, 3, 4];
      Motion.showBetween(tl, TOOLS, 0.2, at.standalone.start + 0.4);
      ROWS.forEach((row) => Motion.show(tl, TOOLS + "-row-" + row, 0.4 + row * 0.1, Motion.fromSide));
      Motion.show(tl, TOOLS + "-peppy-head", at.no_build_system.start + 0.3, fades);
      Motion.show(tl, TOOLS + "-peppy-1", at.regular_project.start + 0.4, Motion.fromSide);
      Motion.show(tl, TOOLS + "-note", Motion.within(at.regular_project, 0.43), fades);
      Motion.pulse(tl, TOOLS + "-peppy-1", Motion.within(at.regular_project, 0.74));
      [0.02, 0.23, 0.47].forEach((share, index) => Motion.show(tl, TOOLS + "-peppy-" + (index + 2), Motion.within(at.your_tools, share), Motion.fromSide));
      Motion.show(tl, TOOLS + "-other", Motion.within(at.your_tools, 0.72), Motion.fromSide);
      // The side of ROS 2: its head, then its cells.
      Motion.show(tl, TOOLS + "-ros2-head", at.ros2_tools.start + 0.1, fades);
      ROWS.forEach((row) => Motion.show(tl, TOOLS + "-ros2-" + row, Motion.within(at.ros2_tools, 0.1) + row * 0.4, Motion.fromSide));
      Motion.pulse(tl, TOOLS + "-ros2-head", Motion.within(at.ros2_tools, 0.42));
      Motion.pulse(tl, TOOLS + "-ros2-2", Motion.within(at.ros2_tools, 0.74));
      // Standalone mode: the lines that read the parameters, the line of the
      // configuration, then the line that runs the node.
      const STANDALONE = ID + "-standalone-code";
      Motion.showBetween(tl, ID + "-standalone", at.standalone.start + 0.5, at.tests_alone.start + 0.1);
      [[[1, 2], 0.02], [[4], 0.3], [[5], 0.46]].forEach(([lines, share]) => Motion.focusLines(tl, STANDALONE, lines, Motion.within(at.standalone_how, share)));
      // The node communicates with the nodes of the stack.
      const talkTime = Motion.within(at.standalone_how, 0.64);
      Motion.showBetween(tl, ID + "-stack", talkTime, at.tests_alone.start + 0.1, fades);
      Motion.draw(tl, ID + "-talks", talkTime + 0.3, 0.5);
      Motion.draw(tl, ID + "-talks-more", talkTime + 0.6, 0.5);
      Motion.travel(tl, ID + "-dot-1", atCode({{ run_wire }}), atNodes({{ run_wire }}), talkTime + 0.9, 0.5, 2);
      Motion.travel(tl, ID + "-dot-2", atNodes({{ run_wire }}), atCode({{ run_wire }}), talkTime + 1.15, 0.5, 2);
      // One test: the sync generates the mock and the harness.
      const TEST = ID + "-test-code";
      const mockTime = Motion.within(at.mocks, 0.31);
      Motion.show(tl, ID + "-test", at.tests_alone.start + 0.2);
      Motion.show(tl, ID + "-sync-note", at.mocks.start + 0.3, fades);
      Motion.show(tl, ID + "-mock", mockTime, Motion.fromSide);
      Motion.draw(tl, ID + "-publishes", mockTime + 0.4, 0.5);
      Motion.show(tl, ID + "-publishes-head", mockTime + 0.8, { from: { opacity: 0, y: 0 }, duration: 0.2 });
      // The harness, the message of the mock, the answer of the node, then
      // the assert.
      const steps = [[[2], Motion.within(at.mocks, 0.8)], [[3, 4, 5], at.one_test.start + 0.2], [[6], Motion.within(at.one_test, 0.56)], [[7], Motion.within(at.one_test, 0.8)], [[], at.ros2_mocks.start - 0.5]];
      steps.forEach(([lines, time]) => Motion.focusLines(tl, TEST, lines, time));
      Motion.travel(tl, ID + "-dot-1", atNodes({{ mock_wire }}), atCode({{ mock_wire }}), at.one_test.start + 0.5, 0.6, 3);
      // In ROS 2, the developer writes each mock. The test goes down, and
      // the comparison card comes in above its code.
      tl.to(ID + "-test", { y: 110, duration: 0.5, ease: "power2.inOut" }, at.ros2_mocks.start - 0.5);
      Motion.show(tl, ID + "-compare-mocks", at.ros2_mocks.start - 0.2, { from: { opacity: 0, x: 70, y: 0 } });
      window.__timelines["{{ id }}"] = tl;
    })();
  </script>
</template>
