{# Segment 8. A launcher declares the parts of a stack that can change as
   component axes. One word of the launch command selects an option, so the
   same launcher runs a simulation, then the real robot. #}
{% from "_parts.html.j2" import backdrop, header, act_intro, problem_scene, rail, term_card, command, icon %}
{% set id = segment.id %}
{% set axis_count = screen.axes.items() | list | length %}
{# The space between the selected option of an axis and the frame around it. #}
{% set seat_gap = 7 %}
{# The width of the picture of what the first axis runs, and the space
   between the launcher and it. #}
{% set world_width = 420 %}
{% set world_gap = 40 %}
<template>
  <style>
    #root {
      position: absolute;
      inset: 0;
    }
    .{{ id }}-layout {
      gap: 56px;
    }
    .{{ id }}-top {
      align-self: stretch;
      display: flex;
      gap: {{ world_gap }}px;
    }
    {# The launcher: a window with one row for each axis. #}
    .{{ id }}-launcher {
      flex: 1;
      display: flex;
      flex-direction: column;
      gap: 16px;
      font-family: var(--sans);
    }
    .{{ id }}-launcher .code-title {
      margin-bottom: 0;
    }
    .{{ id }}-same {
      display: flex;
      align-items: center;
      gap: 12px;
      font-size: 30px;
      font-weight: 500;
      line-height: 42px;
      color: var(--ink);
      white-space: nowrap;
    }
    .{{ id }}-same .icon {
      width: 32px;
      height: 32px;
      color: var(--peppy);
    }
    {# A row holds the name of the axis and its two options, which have the
       same size. The padding of the row is the same on its four sides. #}
    .{{ id }}-axis {
      position: relative;
      display: grid;
      grid-template-columns: 136px 1fr 1fr;
      gap: 18px;
      align-items: center;
      padding: 20px;
      border: 2px dashed var(--line-strong);
      border-radius: 18px;
      background: rgba(14, 22, 38, 0.7);
    }
    .{{ id }}-axis-name {
      font-size: 30px;
      font-weight: 500;
      color: var(--data);
    }
    .{{ id }}-option {
      display: flex;
      align-items: center;
      justify-content: center;
      height: 76px;
      border: 2px solid var(--line-strong);
      border-radius: 12px;
      background: var(--panel);
      font-size: 30px;
      font-weight: 500;
      color: var(--ink-dim);
      white-space: nowrap;
    }
    {# The seat of the row is the place in the stack: a frame around the
       option that runs. The script gives it the place of the first option. #}
    .{{ id }}-seat {
      position: absolute;
      border: 3px solid var(--peppy);
      border-radius: {{ 12 + seat_gap }}px;
    }
    {# What the first axis runs: the robot on the grid of a simulation, or
       the real robot on a plain floor. Its name is above it. #}
    .{{ id }}-world {
      flex: none;
      width: {{ world_width }}px;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 12px;
    }
    {# The two names are at the same place, and the page shows one of them. #}
    .{{ id }}-world-names {
      display: grid;
      justify-items: center;
    }
    .{{ id }}-world-names .label {
      grid-area: 1 / 1;
    }
    .{{ id }}-world-robot {
      flex: 1;
      min-height: 0;
      width: 100%;
    }
    .{{ id }}-word {
      position: absolute;
      left: 0;
      top: 0;
      width: 20px;
      height: 20px;
      margin: -10px 0 0 -10px;
      border-radius: 50%;
      background: var(--peppy);
    }
  </style>
  <div id="root" data-composition-id="{{ id }}" data-width="1920" data-height="1080">
    <div id="{{ id }}-stage" class="stage">
      {{ backdrop(id) }}
      {{ header(segment, act) }}
      <div id="{{ id }}-content">
      {{ act_intro(id, act) }}
      {{ problem_scene(id, segment, screen.problem) }}

      <div id="{{ id }}-concept" class="scene">
        <div class="zone is-centered {{ id }}-layout">
          <div id="{{ id }}-top" class="{{ id }}-top">
            {# The launcher: one row for each component axis. #}
            <div id="{{ id }}-launcher" class="code-window {{ id }}-launcher">
              <div class="code-title">{{ screen.launcher }}</div>
              {% for key, axis in screen.axes.items() %}
              {% set row = loop.index %}
              <div id="{{ id }}-axis-{{ row }}" class="{{ id }}-axis">
                <span id="{{ id }}-axis-{{ row }}-name" class="{{ id }}-axis-name">{{ axis.name }}</span>
                {% for option in axis.options %}
                <div id="{{ id }}-axis-{{ row }}-option-{{ loop.index }}" class="{{ id }}-option"><span id="{{ id }}-axis-{{ row }}-option-{{ loop.index }}-name">{{ option }}</span></div>
                {% endfor %}
                <div id="{{ id }}-axis-{{ row }}-seat" class="{{ id }}-seat" data-layout="over"></div>
              </div>
              {% endfor %}
              <div id="{{ id }}-same" class="{{ id }}-same">{{ icon("lock") }}<span>{{ screen.same_file }}</span></div>
            </div>
            {# What the first axis runs. #}
            <div id="{{ id }}-world" class="{{ id }}-world">
              <div class="{{ id }}-world-names">
                <span id="{{ id }}-simulation-name" class="label is-tag">{{ screen.simulation }}</span>
                <span id="{{ id }}-real-name" class="label is-tag">{{ screen.real_robot }}</span>
              </div>
              <canvas id="{{ id }}-robot" class="robot-canvas {{ id }}-world-robot"></canvas>
            </div>
          </div>
          {{ command(id + "-command", screen.command) }}
        </div>
        <div id="{{ id }}-word" class="{{ id }}-word" data-layout="free"></div>
        {{ rail(id, screen, [
          ["axis", screen.cards.component_axis.term, term_card(id + "-card-axis", screen.cards.component_axis)],
          ["simulation", screen.cards.simulation.term, term_card(id + "-card-simulation", screen.cards.simulation)],
        ]) }}
      </div>

      </div>
    </div>
  </div>
  <script>
    (function () {
      const ID = "#{{ id }}";
      const at = {{ at | tojson }};
      const DURATION = {{ duration }};
      const tl = gsap.timeline({ paused: true });
      const AXES = {{ axis_count }};
      const SEAT_GAP = {{ seat_gap }};
      const LIT = { backgroundColor: Motion.colour("peppy"), borderColor: Motion.colour("peppy"), color: Motion.colour("peppy-ink") };
      const NOT_LIT = { backgroundColor: Motion.colour("panel"), borderColor: Motion.colour("line-strong"), color: Motion.colour("ink-dim") };
      const axis = (number, part) => ID + "-axis-" + number + (part ? "-" + part : "");
      const eachAxis = function (action) {
        for (let number = 1; number <= AXES; number += 1) action(number, number - 1);
      };

      // The seat of each row is around its first option, and it goes to the
      // second option by the distance between the two.
      const row = Motion.boxOf(axis(1));
      const first = Motion.boxOf(axis(1, "option-1"));
      const second = Motion.boxOf(axis(1, "option-2"));
      // The border of a row is 2 px wide, and a seat is in the box inside it.
      gsap.set("." + "{{ id }}-seat", {
        left: first.left - row.left - 2 - SEAT_GAP,
        top: first.top - row.top - 2 - SEAT_GAP,
        width: first.width + 2 * SEAT_GAP,
        height: first.height + 2 * SEAT_GAP,
      });
      const SEAT_STEP = second.left - first.left;
      // Before the picture of what the first axis runs comes in, the launcher
      // is in the middle of the zone.
      const ALONE_SHIFT = {{ (world_width + world_gap) // 2 }};
      gsap.set(ID + "-top", { x: ALONE_SHIFT });
      const moveSeat = (number, x, time, duration) => tl.to(axis(number, "seat"), { x, duration, ease: "power2.inOut" }, time);

      Motion.chapter(tl, ID, {
        duration: DURATION,
        map: [0.2, at.problem.start - 0.3],
        problem: [at.problem.start - 0.2, at.axes.start - 0.2],
        // The card of the simulation comes in when the command selects the simulation.
        terms: [
          ["axis", at.axes.start + 0.5, at.examples.end + 0.2],
          ["simulation", Motion.within(at.select, 0.3) + 0.6, at.later.start - 0.1],
        ],
        benefit: at.later.start,
      });

      // The launcher declares the parts that can change as component axes.
      Motion.show(tl, ID + "-launcher", at.axes.start - 0.1);
      eachAxis(function (number, index) {
        Motion.show(tl, axis(number), Motion.within(at.axes, 0.15) + index * 0.3, Motion.fromSide);
        Motion.show(tl, axis(number, "name"), Motion.within(at.axes, 0.5) + index * 0.3, Motion.fromSide);
      });

      // Each axis has options, and one of them fills the place in the stack:
      // the seat goes from one option to the other, then back.
      eachAxis(function (number, index) {
        Motion.show(tl, axis(number, "option-1"), Motion.within(at.options, 0.2) + index * 0.15, Motion.grows);
        Motion.show(tl, axis(number, "option-2"), Motion.within(at.options, 0.2) + 0.3 + index * 0.15, Motion.grows);
        Motion.show(tl, axis(number, "seat"), Motion.within(at.options, 0.5) + index * 0.1, Motion.appears);
        moveSeat(number, SEAT_STEP, Motion.within(at.options, 0.62) + index * 0.1, 0.5);
        moveSeat(number, 0, Motion.within(at.options, 0.84) + index * 0.1, 0.5);
      });

      // The options of each axis, when the voice names them.
      [0.2, 0.37, 0.58, 0.67, 0.81, 0.92].forEach(function (share, index) {
        const number = Math.floor(index / 2) + 1;
        const option = (index % 2) + 1;
        Motion.show(tl, axis(number, "option-" + option + "-name"), Motion.within(at.examples, share), Motion.appears);
      });

      // One word in the launch command selects an option: the word goes from
      // the end of the command to the first option of the first axis.
      Motion.show(tl, ID + "-command", at.select.start + 0.1);
      const selects = Motion.within(at.select, 0.3);
      const command = Motion.boxOf(ID + "-command");
      Motion.travel(tl, ID + "-word", { x: command.right - 110, y: command.top }, { x: first.x + ALONE_SHIFT, y: first.bottom }, selects, 0.5, 1);
      Motion.paint(tl, axis(1, "option-1"), LIT, selects + 0.5);
      Motion.pulse(tl, axis(1, "option-1"), selects + 0.5);
      // The launcher file stays the same.
      Motion.show(tl, ID + "-same", Motion.within(at.select, 0.62), Motion.appears);

      // With no robot, the first axis runs a simulation: the robot is on the
      // grid of a simulation until the launcher runs the real robot.
      const otherAxes = [];
      eachAxis(function (number) {
        if (number > 1) otherAxes.push(axis(number));
      });
      const swaps = Motion.within(at.later, 0.4);
      RobotView.mount({
        canvas: document.querySelector(ID + "-robot"),
        segmentStart: {{ start }},
        segmentDuration: DURATION,
        turns: [[at.no_robot.start, -50], [DURATION, 30]],
        grid: [[swaps + 0.5, 1], [swaps + 1.3, 0]],
      });
      tl.to(ID + "-top", { x: 0, duration: 0.6, ease: "power2.inOut" }, at.no_robot.start - 0.3);
      Motion.show(tl, ID + "-world", at.no_robot.start + 0.2, Motion.fromRight);
      Motion.show(tl, ID + "-simulation-name", at.no_robot.start + 0.6, Motion.appears);
      Motion.fade(tl, otherAxes.join(", "), 0.4, at.no_robot.start + 0.1);
      Motion.pulse(tl, axis(1, "option-1"), Motion.within(at.no_robot, 0.7));

      // Later, the same launcher runs the real robot: the seat of the first
      // axis goes to the other option, and nothing else in the launcher moves.
      Motion.fade(tl, otherAxes.join(", "), 1, at.later.start + 0.1);
      Motion.paint(tl, axis(1, "option-1"), NOT_LIT, swaps);
      moveSeat(1, SEAT_STEP, swaps, 0.6);
      Motion.paint(tl, axis(1, "option-2"), LIT, swaps + 0.5);
      Motion.pulse(tl, axis(1, "option-2"), swaps + 0.5);
      Motion.hide(tl, ID + "-simulation-name", swaps + 0.8);
      Motion.show(tl, ID + "-real-name", swaps + 0.8, Motion.appears);

      window.__timelines["{{ id }}"] = tl;
    })();
  </script>
</template>
