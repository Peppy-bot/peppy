{# Segment 9. Peppy has an MCP server built in. An exposure lists what an MCP
   client can reach: topics as resources, services and actions as tools. A
   client reaches nothing that the exposure does not name. #}
{% from "_parts.html.j2" import chapter, term_card, comparison_card %}
{% set id = segment.id %}
{# The places of the parts on the page, in pixels. #}
{% set client_left = 96 %}
{% set client_width = 210 %}
{% set client_height = 160 %}
{% set client_right = client_left + client_width %}
{% set peppy_left = 400 %}
{% set peppy_top = 226 %}
{% set peppy_width = 700 %}
{% set server_left = peppy_left + 18 %}
{% set server_top = peppy_top + 68 %}
{% set server_width = peppy_width - 36 %}
{% set exposure_left = server_left + 18 %}
{% set exposure_top = server_top + 66 %}
{% set exposure_width = server_width - 36 %}
{% set row_left = exposure_left + 16 %}
{% set row_width = exposure_width - 32 %}
{% set row_height = 84 %}
{% set row_pitch = row_height + 12 %}
{% set first_row_top = exposure_top + 40 %}
{% set rows = screen.published.items() | list %}
{% set exposure_height = 40 + (rows | length) * row_pitch + 6 %}
{% set server_height = exposure_top + exposure_height + 16 - server_top %}
{% set middle = first_row_top + row_pitch + row_height // 2 %}
{% set client_top = middle - client_height // 2 %}
{# The middle of the contract mark of each row, and the contract below them. #}
{% set mark_x = row_left + row_width - 16 - 23 %}
{% set contract_top = server_top + server_height + 30 %}
{# The part of the stack that the exposure does not name. #}
{% set private_top = contract_top %}
{% set private_middle = private_top + row_height // 2 %}
{# Peppy is as tall as the server, then as tall as all its parts. #}
{% set peppy_height_at_start = server_top + server_height + 18 - peppy_top %}
{% set peppy_height = private_top + row_height + 76 - peppy_top %}
{% set barrier_x = peppy_left - 12 %}
{# The contract: a socket, as in the segment of the contracts. #}
{% macro socket_path(width, height, notch) %}{{ "M 8 0 H %d L %d %d H %d L %d 0 H %d Q %d 0 %d 8 V %d Q %d %d %d %d H 8 Q 0 %d 0 %d V 8 Q 0 0 8 0 Z" | format(width // 2 - notch - 6, width // 2 - notch, height // 4, width // 2 + notch, width // 2 + notch + 6, width - 8, width, width, height - 8, width, height, width - 8, height, height, height - 8) }}{% endmacro %}
<template>
  <style>
    #root {
      position: absolute;
      inset: 0;
    }
    .{{ id }}-client {
      position: absolute;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 10px;
      border: 3px solid var(--line-strong);
      border-radius: 18px;
      background: var(--panel);
      font-size: 30px;
      font-weight: 500;
      line-height: 1.15;
      text-align: center;
    }
    .{{ id }}-client svg {
      width: 40px;
      height: 40px;
      fill: var(--data);
    }
    .{{ id }}-box {
      position: absolute;
      border: 3px solid var(--peppy);
      border-radius: 24px;
      background: rgba(14, 22, 38, 0.6);
    }
    .{{ id }}-box.is-exposure {
      border-color: var(--line-strong);
      border-radius: 18px;
      background: var(--panel);
    }
    .{{ id }}-tab {
      position: absolute;
      left: 24px;
      top: -24px;
      display: flex;
      align-items: center;
      gap: 12px;
      height: 44px;
      padding: 0 16px;
      border: 2px solid var(--peppy);
      border-radius: 10px;
      background: var(--ground);
      font-size: 28px;
      font-weight: 500;
      color: var(--peppy);
      white-space: nowrap;
    }
    .{{ id }}-box.is-exposure .{{ id }}-tab {
      border-color: var(--line-strong);
      color: var(--ink);
    }
    .{{ id }}-tab.is-peppy {
      top: -28px;
      height: 52px;
      padding-left: 8px;
      font-weight: 700;
    }
    .{{ id }}-tab img {
      width: 36px;
      height: 36px;
      padding: 2px;
      border-radius: 9px;
      background: #dfe6f7;
    }
    .{{ id }}-row {
      position: absolute;
      left: {{ row_left }}px;
      width: {{ row_width }}px;
      height: {{ row_height }}px;
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 0 16px;
      border: 2px dashed var(--line-strong);
      border-radius: 14px;
      background: var(--panel-raised);
      font-size: 30px;
      white-space: nowrap;
    }
    .{{ id }}-from {
      width: 106px;
      font-weight: 500;
      color: var(--peppy);
    }
    .{{ id }}-as {
      display: flex;
      align-items: center;
      gap: 12px;
      font-weight: 700;
      color: var(--ink);
    }
    .{{ id }}-as svg {
      width: 36px;
      height: 20px;
      fill: none;
      stroke: var(--ink-dim);
      stroke-width: 3;
      stroke-linecap: round;
      stroke-linejoin: round;
    }
    .{{ id }}-task {
      position: relative;
      overflow: hidden;
      padding: 2px 12px;
      border: 2px solid var(--data);
      border-radius: 10px;
      font-size: 28px;
      font-weight: 500;
      color: var(--ink);
    }
    .{{ id }}-task-progress {
      position: absolute;
      inset: 0;
      background: rgba(95, 212, 240, 0.32);
      transform-origin: left center;
    }
    .{{ id }}-task-name {
      position: relative;
    }
    .{{ id }}-mark {
      width: 46px;
      height: 30px;
      margin-left: auto;
      overflow: visible;
    }
    .{{ id }}-mark path,
    .{{ id }}-contract path {
      fill: #1b1533;
      stroke: var(--contract);
      stroke-width: 4;
      stroke-linejoin: round;
    }
    .{{ id }}-contract {
      position: absolute;
      left: {{ mark_x - 76 }}px;
      top: {{ contract_top }}px;
      width: 152px;
      height: 62px;
    }
    .{{ id }}-contract svg {
      position: absolute;
      left: 0;
      top: 0;
      width: 100%;
      height: 100%;
      overflow: visible;
    }
    .{{ id }}-contract-name {
      position: absolute;
      left: 0;
      top: 14px;
      width: 100%;
      height: 46px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 28px;
      font-weight: 700;
      color: var(--contract);
    }
    .{{ id }}-private {
      justify-content: space-between;
      width: 250px;
      padding: 0 22px;
    }
    .{{ id }}-private-blank {
      width: 120px;
      height: 12px;
      border-radius: 6px;
      background: var(--line-strong);
    }
    .{{ id }}-private svg {
      width: 30px;
      height: 36px;
    }
    .{{ id }}-lock-body {
      fill: var(--fault);
    }
    .{{ id }}-lock-shackle {
      fill: none;
      stroke: var(--fault);
      stroke-width: 4;
      stroke-linecap: round;
    }
    .{{ id }}-port {
      fill: var(--data);
    }
    .{{ id }}-barrier {
      fill: none;
      stroke: var(--fault);
      stroke-width: 10;
      stroke-linecap: round;
    }
  </style>
  <div id="root" data-composition-id="{{ id }}" data-width="1920" data-height="1080">
    <div id="{{ id }}-stage" class="stage">
      {{ chapter(number, segment.chapter) }}
      <div id="{{ id }}-content">

      <div id="{{ id }}-peppy" class="{{ id }}-box" style="left: {{ peppy_left }}px; top: {{ peppy_top }}px; width: {{ peppy_width }}px; height: {{ peppy_height }}px">
        <div class="{{ id }}-tab is-peppy"><img src="assets/pictures/peppy-logo.webp" alt="" /><span>{{ labels.peppy }}</span></div>
      </div>
      <div id="{{ id }}-server" class="{{ id }}-box" style="left: {{ server_left }}px; top: {{ server_top }}px; width: {{ server_width }}px; height: {{ server_height }}px">
        <div class="{{ id }}-tab">{{ screen.server }}</div>
      </div>
      <div id="{{ id }}-exposure" class="{{ id }}-box is-exposure" style="left: {{ exposure_left }}px; top: {{ exposure_top }}px; width: {{ exposure_width }}px; height: {{ exposure_height }}px">
        <div class="{{ id }}-tab">{{ screen.exposure }}</div>
      </div>

      <svg class="wires" viewBox="0 0 1920 1080">
        <path id="{{ id }}-trunk" class="wire" pathLength="1" d="M {{ client_right }} {{ middle }} H {{ server_left - 16 }}" />
        <polygon id="{{ id }}-trunk-head" class="wire-head" points="{{ server_left - 18 }},{{ middle - 10 }} {{ server_left - 2 }},{{ middle }} {{ server_left - 18 }},{{ middle + 10 }}" />
        {% for kind, row in rows %}
        {% set row_middle = first_row_top + loop.index0 * row_pitch + row_height // 2 %}
        {% set start_y = middle + (loop.index0 - 1) * 30 %}
        <path id="{{ id }}-wire-{{ kind }}" class="wire" pathLength="1" d="M {{ client_right }} {{ start_y }} C {{ client_right + 80 }} {{ start_y }}, {{ row_left - 80 }} {{ row_middle }}, {{ row_left }} {{ row_middle }}" />
        {% endfor %}
        <path id="{{ id }}-wire-private" class="wire" pathLength="1" d="M {{ client_right }} {{ middle + 60 }} C {{ client_right + 56 }} {{ middle + 60 }}, {{ barrier_x - 62 }} {{ private_middle }}, {{ barrier_x - 12 }} {{ private_middle }}" />
        <path id="{{ id }}-barrier" class="{{ id }}-barrier" pathLength="1" d="M {{ barrier_x }} {{ private_middle - 32 }} V {{ private_middle + 32 }}" />
      </svg>

      <div id="{{ id }}-client" class="{{ id }}-client" style="left: {{ client_left }}px; top: {{ client_top }}px; width: {{ client_width }}px; height: {{ client_height }}px">
        <svg viewBox="0 0 40 40"><path d="M 20 1 C 22 12 28 18 39 20 C 28 22 22 28 20 39 C 18 28 12 22 1 20 C 12 18 18 12 20 1 Z" /></svg>
        <span>{{ screen.client }}</span>
      </div>

      {% for kind, row in rows %}
      <div id="{{ id }}-row-{{ kind }}" class="{{ id }}-row" style="top: {{ first_row_top + loop.index0 * row_pitch }}px">
        <span id="{{ id }}-from-{{ kind }}" class="{{ id }}-from">{{ row.from }}</span>
        <span id="{{ id }}-as-{{ kind }}" class="{{ id }}-as">
          <svg viewBox="0 0 36 20"><path d="M 2 10 H 32 M 24 3 L 33 10 L 24 17" /></svg>
          <span>{{ row.as }}</span>
        </span>
        {% if "task" in row %}
        <span id="{{ id }}-task" class="{{ id }}-task">
          <span id="{{ id }}-task-progress" class="{{ id }}-task-progress"></span>
          <span class="{{ id }}-task-name">{{ row.task }}</span>
        </span>
        {% endif %}
        <svg id="{{ id }}-mark-{{ kind }}" class="{{ id }}-mark" viewBox="0 0 46 30"><path d="{{ socket_path(46, 30, 7) }}" /></svg>
      </div>
      {% endfor %}

      <div id="{{ id }}-contract" class="{{ id }}-contract">
        <svg viewBox="0 0 152 62"><path d="{{ socket_path(152, 62, 20) }}" /></svg>
        <span class="{{ id }}-contract-name">{{ screen.contract }}</span>
      </div>
      <svg class="wires" viewBox="0 0 1920 1080">
        {% for kind, row in rows | reverse %}
        {% set row_middle = first_row_top + (loop.revindex0) * row_pitch + row_height // 2 %}
        <path id="{{ id }}-schema-{{ kind }}" class="wire is-contract" pathLength="1" d="M {{ mark_x }} {{ contract_top - 2 if loop.first else row_middle + row_pitch - 21 }} V {{ row_middle + 21 }}" />
        {% endfor %}
        {% for kind, row in rows %}
        <circle id="{{ id }}-port-{{ kind }}" class="{{ id }}-port" cx="{{ row_left }}" cy="{{ first_row_top + loop.index0 * row_pitch + row_height // 2 }}" r="8" />
        {% endfor %}
      </svg>

      <div id="{{ id }}-private" class="{{ id }}-row {{ id }}-private" style="left: {{ exposure_left }}px; top: {{ private_top }}px">
        <span class="{{ id }}-private-blank"></span>
        <svg id="{{ id }}-lock" viewBox="0 0 30 36">
          <path class="{{ id }}-lock-shackle" d="M 8 16 V 11 A 7 7 0 0 1 22 11 V 16" />
          <rect class="{{ id }}-lock-body" x="3" y="16" width="24" height="18" rx="4" />
        </svg>
      </div>
      <div id="{{ id }}-closed" class="label is-fault" style="left: {{ exposure_left }}px; top: {{ private_top + row_height + 12 }}px">{{ screen.closed }}</div>

      {% for kind, row in rows %}
      <div id="{{ id }}-dot-{{ kind }}" class="dot"></div>
      {% endfor %}
      <div id="{{ id }}-dot-private" class="dot"></div>

      {{ term_card(id + "-card-mcp", screen.cards.mcp) }}
      {{ term_card(id + "-card-exposure", screen.cards.exposure) }}
      {{ comparison_card(id + "-comparison", screen.comparisons.mcp) }}
      </div>
    </div>
  </div>
  <script>
    (function () {
      const ID = "#{{ id }}";
      const at = {{ at | tojson }};
      const DURATION = {{ duration }};
      const tl = gsap.timeline({ paused: true });
      const KINDS = [{% for kind, row in rows %}"{{ kind }}"{{ ", " if not loop.last else "" }}{% endfor %}];
      const POP = { from: { opacity: 0, scale: 0.6, y: 0 } };
      const DATA = "#5fd4f0";
      const FAULT = "#ff6b81";
      // When the voice names the source of each row and what it becomes, as
      // shares of the sentence.
      const NAMED = { topic: [0.16, 0.45], service: [0.62, 0.92], action: [0.8, 0.95] };

      Motion.endSegment(tl, ID + "-content", DURATION);

      // The server is a part of Peppy, and an LLM application is its client.
      Motion.show(tl, ID + "-peppy", at.built_in.start + 0.1, { from: { opacity: 0, scale: 0.97 } });
      Motion.show(tl, ID + "-server", at.built_in.start + Motion.lasts(at.built_in) * 0.35, { from: { opacity: 0, scale: 0.94 } });
      Motion.show(tl, ID + "-client", at.built_in.start + Motion.lasts(at.built_in) * 0.8, { from: { opacity: 0, x: -40, y: 0 } });
      Motion.draw(tl, ID + "-trunk", at.built_in.end + 0.1, 0.4);
      Motion.show(tl, ID + "-trunk-head", at.built_in.end + 0.4, { from: { opacity: 0 }, duration: 0.2 });
      Motion.card(tl, ID + "-card-mcp", at.built_in.start + 0.3, at.exposure.start + 2.9);

      // The exposure: a list, with one row for each thing that it names.
      Motion.show(tl, ID + "-exposure", at.exposure.start + 0.2);
      KINDS.forEach(function (kind, index) {
        Motion.show(tl, ID + "-row-" + kind, at.exposure.start + Motion.lasts(at.exposure) * 0.5 + index * 0.3);
      });
      Motion.card(tl, ID + "-card-exposure", at.exposure.start + 3.1, at.only_named.end + 0.3);

      // What each row publishes.
      KINDS.forEach(function (kind) {
        const [fromShare, asShare] = NAMED[kind];
        const fromTime = at.publishes.start + Motion.lasts(at.publishes) * fromShare;
        Motion.show(tl, ID + "-from-" + kind, fromTime, { from: { opacity: 0, x: -20, y: 0 } });
        tl.set(ID + "-row-" + kind, { borderStyle: "solid" }, fromTime);
        Motion.show(tl, ID + "-as-" + kind, at.publishes.start + Motion.lasts(at.publishes) * asShare, { from: { opacity: 0, x: -20, y: 0 } });
      });

      // An action can run as a task, and the task has a progress.
      Motion.show(tl, ID + "-task", at.task.start + Motion.lasts(at.task) * 0.3, { from: { opacity: 0, x: -20, y: 0 } });
      tl.fromTo(
        ID + "-task-progress",
        { scaleX: 0 },
        { scaleX: 1, duration: Motion.lasts(at.task) * 0.5, ease: "none" },
        at.task.start + Motion.lasts(at.task) * 0.6,
      );

      // The schema of each row comes from the contract, which is a part of
      // the stack below the server.
      tl.fromTo(
        ID + "-peppy",
        { height: {{ peppy_height_at_start }} },
        { height: {{ peppy_height }}, duration: 0.6, ease: "power2.inOut" },
        at.schemas.start - 0.2,
      );
      Motion.show(tl, ID + "-contract", at.schemas.start + 0.3, POP);
      KINDS.slice().reverse().forEach(function (kind, index) {
        const time = at.schemas.start + 0.8 + index * 0.4;
        Motion.draw(tl, ID + "-schema-" + kind, time, 0.3);
        Motion.show(tl, ID + "-mark-" + kind, time + 0.25, POP);
      });

      // The client reaches each row of the exposure, and nothing else.
      Motion.hide(tl, [ID + "-trunk", ID + "-trunk-head"], at.only_named.start + 0.7);
      KINDS.forEach(function (kind, index) {
        const time = at.only_named.start + 0.2 + index * 0.2;
        Motion.draw(tl, ID + "-wire-" + kind, time, 0.6);
        Motion.show(tl, ID + "-port-" + kind, time + 0.5, { from: { opacity: 0 }, duration: 0.2 });
        tl.to(ID + "-row-" + kind, { borderColor: DATA, duration: 0.3 }, time + 0.6);
        Motion.follow(tl, ID + "-dot-" + kind, ID + "-wire-" + kind, time + 0.8, 0.7, 2);
      });
      const privateTime = at.only_named.start + Motion.lasts(at.only_named) * 0.45;
      Motion.show(tl, ID + "-private", privateTime, POP);
      Motion.draw(tl, ID + "-wire-private", privateTime + 0.5, 0.6);
      Motion.draw(tl, ID + "-barrier", privateTime + 1.05, 0.2);
      Motion.show(tl, ID + "-lock", privateTime + 1.2, POP);
      tl.to(ID + "-wire-private", { stroke: FAULT, duration: 0.3 }, privateTime + 1.2);
      tl.to(ID + "-private", { borderColor: FAULT, duration: 0.3 }, privateTime + 1.2);

      // The rows are open to the LLM, and the other part stays closed.
      Motion.show(tl, ID + "-comparison", at.open_some.start + 0.4, { from: { opacity: 0, x: 70, y: 0 } });
      KINDS.forEach(function (kind, index) {
        Motion.follow(tl, ID + "-dot-" + kind, ID + "-wire-" + kind, at.open_some.start + 0.5 + index * 0.25, 0.7, 3);
      });
      const closedTime = at.open_some.start + Motion.lasts(at.open_some) * 0.58;
      Motion.show(tl, ID + "-closed", closedTime);
      Motion.follow(tl, ID + "-dot-private", ID + "-wire-private", closedTime + 0.4, 0.6, 1);
      Motion.pulse(tl, ID + "-private", closedTime + 1.0);
      Motion.follow(tl, ID + "-dot-private", ID + "-wire-private", closedTime + 1.8, 0.6, 1);

      window.__timelines["{{ id }}"] = tl;
    })();
  </script>
</template>
