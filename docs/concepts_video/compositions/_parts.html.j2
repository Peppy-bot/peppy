  "cloud": '<path d="M7 18 h10 a4 4 0 0 0 0.6 -7.95 a5.6 5.6 0 0 0 -10.9 -1.1 a4.6 4.6 0 0 0 0.3 9.05 z" />',
  "chip": '<rect x="6" y="6" width="12" height="12" rx="2" /><rect x="9.5" y="9.5" width="5" height="5" rx="1" /><path d="M9 6 v-2.5 M12 6 v-2.5 M15 6 v-2.5 M9 20.5 v-2.5 M12 20.5 v-2.5 M15 20.5 v-2.5 M6 9 h-2.5 M6 12 h-2.5 M6 15 h-2.5 M20.5 9 h-2.5 M20.5 12 h-2.5 M20.5 15 h-2.5" />',
