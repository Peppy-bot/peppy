  "check": '<path d="M5 12.5 l4.5 4.5 l9.5 -10" />',
  "person": '<circle cx="12" cy="8" r="3.8" /><path d="M4.5 20.5 c0 -4.6 3.3 -7.2 7.5 -7.2 s7.5 2.6 7.5 7.2" />',
  "laptop": '<rect x="5" y="5" width="14" height="10" rx="1.5" /><path d="M2.5 18.5 h19" />',
  "down": '<path d="M12 4 v15 M5.5 12.5 l6.5 6.5 l6.5 -6.5" />',
