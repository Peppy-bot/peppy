  "sliders": '<path d="M4 8 h16 M4 16 h16" /><circle cx="14.5" cy="8" r="2.4" /><circle cx="9" cy="16" r="2.4" />',
  "link": '<circle cx="6" cy="12" r="2.6" /><circle cx="18" cy="12" r="2.6" /><path d="M8.6 12 h6.8" />',
