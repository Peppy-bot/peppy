{
    "$schema": "https://railway.com/railway.schema.json",
    "build": {
        "builder": "RAILPACK",
        "watchPatterns": [
            "docs/**"
        ]
    },
    "deploy": {
        "startCommand": "npx serve dist -l tcp://0.0.0.0:${PORT:-3000}",
        "healthcheckPath": "/",
        "healthcheckTimeout": 300,
        "restartPolicyType": "ALWAYS",
        "restartPolicyMaxRetries": 5,
        "multiRegionConfig": {
            "us-west1": {
                "numReplicas": 1
            },
            "asia-southeast1": {
                "numReplicas": 1
            }
        }
    }
}