{
    peppy_schema: "contract/v1",
    manifest: {
        name: "rgb_camera",
        tag: "v1",
        description: ["A color camera: its frames, its status and its settings."],
    },
    interfaces: {
        topics: [
            {
                name: "video_stream",
                description: "Each frame of the camera, as it is captured.",
                qos_profile: "sensor_data",
                message_format: {
                    header: { $type: "object", stamp: "time", frame_id: "u32" },
                    encoding: "string",
                    width: "u32",
                    height: "u32",
                    frame: { $type: "array", $items: "u8" },
                },
            },
            {
                name: "camera_status",
                description: "The state of the camera, about once a second.",
                message_format: {
                    temperature_c: { $type: "i16", $description: "The temperature of the sensor, in degrees Celsius." },
                    recording: "bool",
                },
            },
        ],
        services: [
            {
                name: "video_stream_info",
                description: "Give the size, the rate and the encoding of the frames.",
                response_message_format: {
                    width: "u32",
                    height: "u32",
                    frames_per_second: "u8",
                    encoding: "string",
                },
            },
            {
                name: "set_brightness",
                description: "Set the brightness of the frames, and give the value that the camera keeps.",
                request_message_format: {
                    value: { $type: "i32", $description: "The brightness, in the units of the device." },
                },
                response_message_format: {
                    success: "bool",
                    message: "string",
                    current_value: "i32",
                },
            },
            {
                name: "seek",
                description: "Move the playback of a recorded stream to a position.",
                request_message_format: {
                    position: "u64",
                    label: "string",
                    speed: "f32",
                },
                response_message_format: { success: "bool" },
            },
        ],
    },
}
