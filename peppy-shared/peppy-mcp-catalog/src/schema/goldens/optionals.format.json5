// $optional on every shape that allows it: string, bytes, time, object, and
// array, at the root, on a field of a nested object, and on a field of the
// objects an array holds.
{
  required_label: "string",
  optional_label: { $type: "string", $optional: true },
  optional_blob: { $type: "bytes", $optional: true },
  optional_stamp: { $type: "time", $optional: true },
  optional_extent: {
    $type: "object",
    $optional: true,
    width: "u32",
    height: "u32",
    optional_unit: { $type: "string", $optional: true },
  },
  optional_samples: {
    $type: "array",
    $items: {
      $type: "object",
      value: "f64",
      optional_stamp: { $type: "time", $optional: true },
    },
    $optional: true,
  },
}
