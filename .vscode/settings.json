{
  "rust-analyzer.checkOnSave": true,
  "rust-analyzer.check.overrideCommand": [
    "cargo",
    "check",
    "--workspace",
    "--message-format=json"
  ],
  "python.defaultInterpreterPath": "${workspaceFolder}/crates/peppylib-py/.pixi/envs/default/bin/python",
  "python.testing.pytestEnabled": true,
  "python.testing.pytestArgs": [
    "crates/peppylib-py/tests"
  ],
  "rust-analyzer.linkedProjects": [
    "Cargo.toml",
    "docs/tests/integration/Cargo.toml"
  ],
  "python.terminal.activateEnvironment": false,
  "debug.inlineValues": "on",
  "debug.allowBreakpointsEverywhere": true,
  "python.autoComplete.extraPaths": [
    "crates/peppylib-py/tests",
    "docs/src/content/docs/guides/snippets/python/first_node/.peppy/libs/peppygen",
    "docs/src/content/docs/guides/snippets/python/hello_receiver/.peppy/libs/peppygen",
    "docs/src/content/docs/guides/snippets/python/my_first_node/.peppy/libs/peppygen",
    "docs/src/content/docs/guides/snippets/python/hello_world_param/.peppy/libs/peppygen",
    "docs/src/content/docs/guides/snippets/python/standalone/.peppy/libs/peppygen"
  ],
  "python.analysis.extraPaths": [
    "crates/peppylib-py/tests",
    "docs/src/content/docs/guides/snippets/python/first_node/.peppy/libs/peppygen",
    "docs/src/content/docs/guides/snippets/python/hello_receiver/.peppy/libs/peppygen",
    "docs/src/content/docs/guides/snippets/python/my_first_node/.peppy/libs/peppygen",
    "docs/src/content/docs/guides/snippets/python/hello_world_param/.peppy/libs/peppygen",
    "docs/src/content/docs/guides/snippets/python/standalone/.peppy/libs/peppygen"
  ]
}