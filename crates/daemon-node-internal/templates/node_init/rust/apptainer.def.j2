Bootstrap: docker
From: ubuntu:24.04

%labels
    Name {{ node_name }}
    Version {{ tag }}

%environment
    export PATH="/root/.cargo/bin:$PATH"

%files
    . /opt/{{ node_name }}

%post
    set -eux

    apt-get update
    apt-get install -y --no-install-recommends \
        ca-certificates curl build-essential pkg-config
    rm -rf /var/lib/apt/lists/*

    curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y
    export PATH="/root/.cargo/bin:$PATH"

    cd /opt/{{ node_name }}
    cargo build --release

%runscript
    exec /opt/{{ node_name }}/target/release/{{ node_name }}
