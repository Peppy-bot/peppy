{
    node_config: {
        name: "hello_world_emit",
        namespace: "/",
        version: "0.1.0",
        respawn: true,
        respawn_delay: 1
    },
    resources: {
        max_memory_mb: 1024
    },
    logging: {
        min_level: "info",
        file_path: "${LOGS_ROOT_DIR}/hello_world_emit_node.log",
        max_file_size_mb: 10,
        format: "text"
    }
}