// The copies of the running launch: list them, add one, remove one. The
// peppy daemon that coordinates the stack serves this interface, and no
// node implements it; every other daemon of the stack passes each call to
// it. The scope that the launcher gives the target of a client limits every
// member to the options it names and the features it gives them. A machine
// is the core node name of a peppy daemon. A join or a removal follows the
// leases of fleet:v1: a join by a lease holder leases the new robot to it,
// and a join is refused during a halt; a join under the name of a robot that
// another client leases, and the removal of a robot that another client
// leases, are refused with the failure kind leased.
{
  peppy_schema: "contract/v1",
  manifest: { name: "stack_copies", tag: "v1" },
  // The kinds of the daemon beside the kinds of peppy, which join and
  // remove give. Each meaning is the meaning that the daemon gives it.
  failure_kinds: {
    busy: "Other work runs on the daemon; the same request can succeed once that work ends",
    halted: "The stack is halted",
    leased: "Another client holds the lease of the robot; the message names the holder and the lease name",
  },
  interfaces: {
    services: [
      {
        // The options of the scope with their models and their features, the
        // machines of the federation now, the copies of these options on the
        // stack, in name order, and the addition or removal of a copy of one
        // of them that runs now. Each copy is a valid `join` goal, which adds
        // the same copy on the same machines.
        name: "list",
        response_message_format: {
          options: {
            $type: "array",
            $items: {
              $type: "object",
              // The launcher option, the value `join` takes.
              option: "string",
              // The robot model a copy of the option is, as the scope names
              // it.
              model: "string",
              // The one-line description the scope gives the option.
              description: "string",
              // The features a copy of the option may hold, in the scope's
              // order; empty when it offers none.
              features: {
                $type: "array",
                $items: {
                  $type: "object",
                  // The feature, the value a `join` feature item takes.
                  feature: "string",
                  // The one-line description the scope gives the feature.
                  description: "string",
                },
              },
              // simulated when every instance that the option and its
              // features can bring reads the clock of a simulation, else
              // physical.
              kind: { $type: "string", $enum: ["simulated", "physical"] },
            },
          },
          // This machine and every live daemon of the same workspace or
          // project, each once, in name order, read on every call.
          core_nodes: { $type: "array", $items: "string" },
          // The machine of this stack: the coordinator.
          this_core_node: "string",
          copies: {
            $type: "array",
            $items: {
              $type: "object",
              // The copy's name: the prefix of its instance ids.
              name: "string",
              // The launcher option the copy runs.
              option: "string",
              // The copy's machine, which runs its base.
              core_node: "string",
              // The features of the option the copy holds, in the scope's
              // order, each with the machine that runs its part.
              features: {
                $type: "array",
                $items: {
                  $type: "object",
                  feature: "string",
                  core_node: "string",
                },
              },
              // Whether every instance of the copy runs.
              running: "bool",
            },
          },
          // The most copies of the scope's options on the stack: `join`
          // refuses when the stack holds this many.
          max_copies: "u16",
          // The addition or removal of a copy of a scoped option that runs on
          // the stack now; absent while none runs. A copy that joins is in
          // `copies` only once its join ends.
          change: {
            $type: "object",
            $optional: true,
            action: { $type: "string", $enum: ["join", "remove"] },
            name: "string",
            option: "string",
          },
          // The launcher of the stack.
          launcher: "string",
        },
      },
    ],
    actions: [
      {
        // Adds a copy of an option on a machine, with the features it
        // names, each part on its machine, as `peppy stack join
        // OPTION:NAME@CORE_NODE` does with the `axis=option@CORE_NODE` word
        // of each feature: the option's entry in the launcher decides the
        // rest of the copy's selection. Refused when the option is not in
        // the scope, when a feature is not a feature of the option or is
        // named twice, when a copy on the stack has the name, when the stack
        // holds max_copies copies of the scope's options, and, with the
        // failure kind busy, while another stack change or node operation
        // runs on the daemon. A join that ran and failed
        // gives its failure kind and a message that names the log files,
        // and is undone: resource_unavailable when a machine is not live,
        // timeout when a phase went quiet past its budget, attempt_failed
        // when an add, a build or a start failed. A completed join gives no
        // result: the copy is on the stack. A cancel stops the join and
        // undoes it as a failure at the same step does, and the goal ends
        // cancelled.
        name: "join",
        goal_service: {
          request_message_format: {
            name: "string",
            option: "string",
            // The copy's machine, which runs its base.
            core_node: "string",
            // The features of the copy, each with the machine of its part;
            // empty for the copy of the launcher's entry.
            features: {
              $type: "array",
              $items: {
                $type: "object",
                feature: "string",
                core_node: "string",
              },
            },
          },
        },
        // One message per line of the join's log, in order.
        feedback_topic: {
          qos_profile: "standard",
          message_format: {
            // launch, add, build or run.
            step: "string",
            line: "string",
          },
        },
        failure_kinds: ["busy", "halted", "leased"],
      },
      {
        // Stops and removes a copy, as `peppy stack remove NAME` does.
        // Refused when no copy of a scoped option has the name, and, with
        // the failure kind busy, while another stack change or node
        // operation runs on the daemon. A removal that ran and
        // failed gives its failure kind and a message that names the log
        // file; the copy stays listed, and a removal again stops what is
        // left of it. A completed removal gives no result: the copy is off
        // the stack. A cancel stops the removal before its next stop, and
        // the goal ends cancelled.
        name: "remove",
        goal_service: {
          request_message_format: {
            name: "string",
          },
        },
        // One message per line of the removal's log, in order: one at
        // least for each instance it stops, on each machine.
        feedback_topic: {
          qos_profile: "standard",
          message_format: {
            step: "string",
            line: "string",
          },
        },
        failure_kinds: ["busy", "leased"],
      },
    ],
  },
}
