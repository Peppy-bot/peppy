{
  peppy_schema: "contract/v1",
  manifest: {
    name: "robot_leases",
    tag: "v1",
    description: [
      "The fleet of the stack: its robots, the leases that give one client the right to move one robot, and the halt of the whole stack. The peppy daemon that coordinates the stack serves this interface, and no node implements it. The daemon target of each instance of the stack reaches that daemon; a daemon that runs the slice of a launch that another machine coordinates refuses each call with precondition_failed and names the coordinator. The scope that a launcher gives a target of this interface names the members that its client may call; `lease` brings `take`, `release`, `offer`, `open` and `close`. `check_move` answers every client.",
      "A robot is a copy of the stack, a device included: the fleet listing gives it under the name of its copy. A client is named by its instance and the machine of that instance. Only a node whose `lease` goal runs holds leases. A lease ends at its release, at a halt, and when its holder is gone: the process of the holder ends, or its `lease` goal ends. A lease that its holder received goes back to its giver instead, or ends when the giver is gone. No client takes the lease of a robot while a removal of it runs. A new launch and a stack reset end every lease and offer.",
      "Each change of the fleet counts one revision of it: `changes` gives the revision of each change, and `check_move` the revision that its answer reads, so a client orders an answer and a change.",
      "The leases and the halt bind only the clients that ask the daemon before they move a robot. They prevent conflicts between clients. They are not a safety function: the emergency stop of the robots stays in their certified layers.",
    ],
  },
  failure_kinds: {
    halted: "The stack is halted",
    leased: "Another client holds the lease of the robot; the message names the holder and the lease name",
    not_leased: "The asker holds no lease of the robot; the message says how its lease ended",
  },
  interfaces: {
    services: [
      {
        name: "list",
        description: "The fleet listing.",
        response_message_format: {
          version: { $type: "string", $description: "The release tag of a release build of peppy, else `unknown`." },
          core_node: { $type: "string", $description: "The machine of the daemon that coordinates the stack." },
          launcher: { $type: "string", $description: "The launcher of the stack; empty when no launch runs." },
          halted: { $type: "bool", $description: "Whether the stack is halted." },
          halted_by: { $type: "string", $description: "The client that halted the stack." },
          robots: {
            $type: "array",
            $description: "Each robot of the stack, in name order.",
            $items: {
              $type: "object",
              name: { $type: "string", $description: "The name of the copy of the robot." },
              option: { $type: "string", $description: "The launcher option of the copy." },
              core_node: { $type: "string", $description: "The machine of the copy, which runs its base." },
              kind: { $type: "string", $enum: ["simulated", "physical"], $description: "simulated when every instance of the copy reads the clock of a simulation, else physical." },
              clock: { $type: "string", $description: "The clock that the robot reads: `wall`, or the simulated domain that every instance of the copy reads." },
              software: { $type: "string", $enum: ["running", "stopped"], $description: "running when every instance of the copy runs." },
              robot_commander: { $type: "string", $description: "The option of the copy on the axis that the launcher marks as the robot commander axis; empty when that option is `none`, or when no axis has the mark." },
              instances: {
                $type: "array",
                $description: "Each instance of the copy: its name in the copy, the id that the stack runs it under (`instance`), its machine and its node.",
                $items: {
                  $type: "object",
                  name: "string",
                  instance: "string",
                  core_node: "string",
                  node: "string",
                  node_tag: "string",
                },
              },
              contracts: {
                $type: "array",
                $description: "Each contract that an instance of the copy implements, with the sha256 of its pinned document and the name in the copy of each instance that implements it.",
                $items: {
                  $type: "object",
                  name: "string",
                  tag: "string",
                  sha256: "string",
                  instances: { $type: "array", $items: "string" },
                },
              },
            },
          },
          leases: {
            $type: "array",
            $description: "Each lease, in robot name order. A lease stays when its robot leaves the stack, until its release.",
            $items: {
              $type: "object",
              robot: { $type: "string", $description: "The robot of the lease." },
              holder: { $type: "string", $description: "The instance that holds the lease and its machine." },
              holder_core_node: "string",
              name: { $type: "string", $description: "The name that the holder gave the lease, such as the name of a run." },
              open: { $type: "bool", $description: "Whether the holder opened the lease: any client may move the robot while it is open." },
              giver: { $type: "string", $description: "The instance that gave the lease to its holder and its machine; empty for a lease that its holder took." },
              giver_core_node: "string",
              receiver: { $type: "string", $description: "The instance that the holder offers the lease to and its machine; empty when no offer runs." },
              receiver_core_node: "string",
            },
          },
          options: {
            $type: "array",
            $description: "Each option and feature that a robot_membership scope of the launch names, with the contracts that its instances implement.",
            $items: {
              $type: "object",
              option: "string",
              kind: { $type: "string", $enum: ["simulated", "physical"], $description: "simulated when every instance that the option and its features can bring reads the clock of a simulation." },
              contracts: {
                $type: "array",
                $items: { $type: "object", name: "string", tag: "string", sha256: "string" },
              },
              features: {
                $type: "array",
                $items: {
                  $type: "object",
                  feature: "string",
                  contracts: {
                    $type: "array",
                    $description: "The contracts that the feature adds to the option.",
                    $items: { $type: "object", name: "string", tag: "string", sha256: "string" },
                  },
                },
              },
            },
          },
          documents: {
            $type: "array",
            $description: "The pinned document of each contract that `options` names, as written, comments included.",
            $items: {
              $type: "object",
              name: "string",
              tag: "string",
              sha256: "string",
              document: "string",
            },
          },
          nodes: {
            $type: "array",
            $description: "Each node of the stack, with the pinned manifest and the commit of each machine that runs it, and its instances.",
            $items: {
              $type: "object",
              name: "string",
              tag: "string",
              machines: {
                $type: "array",
                $items: {
                  $type: "object",
                  core_node: "string",
                  manifest_sha256: { $type: "string", $description: "The sha256 of the pinned manifest that the machine runs." },
                  commit: { $type: "string", $description: "The commit of the node that the daemon of the machine built; empty for a node with no commit, such as one from a local directory." },
                },
              },
              instances: {
                $type: "array",
                $items: {
                  $type: "object",
                  instance: "string",
                  core_node: "string",
                  robot: { $type: "string", $description: "The robot of the instance; empty for an instance outside any copy." },
                },
              },
            },
          },
        },
      },
      {
        name: "contract",
        description: "A pinned document of the contract cache of the daemon, as written. Refused with rejected when the daemon holds no document of that name, tag and sha256.",
        request_message_format: { name: "string", tag: "string", sha256: "string" },
        response_message_format: { document: "string" },
      },
      {
        name: "take",
        description: "Takes the lease of a robot for the sender, under a name that a refusal gives to other clients. Refused with halted during a halt, with leased when another client holds the lease and did not offer it to the sender, and with precondition_failed when no `lease` goal of the sender runs and while a removal of the robot runs. A lease that its holder offered to the sender changes holder in one step. The call returns once the daemon records the lease.",
        request_message_format: { robot: "string", name: "string" },
        failure_kinds: ["halted", "leased"],
      },
      {
        name: "release",
        description: "Releases a lease of the sender. A lease that the sender received goes back to its giver. Refused with not_leased when the sender holds no lease of the robot. The call returns once the daemon records the release.",
        request_message_format: { robot: "string" },
        failure_kinds: ["not_leased"],
      },
      {
        name: "offer",
        description: "Offers leases of the sender to another node, named by its instance. Each lease stays its own, and the fleet listing gives the receiver of each offer once the call returns. Refused with halted during a halt, with not_leased when the sender holds no lease of a robot, and with precondition_failed for a lease that the sender received: a receiver does not offer a lease again. An offer ends at the take, at a release by the giver, at the end of the lease, at an offer of the same lease to another receiver, and when the giver or the receiver is gone. An offer of a lease to the receiver that it is offered to already changes nothing.",
        request_message_format: {
          robots: { $type: "array", $items: "string" },
          receiver: "string",
        },
        failure_kinds: ["halted", "not_leased"],
      },
      {
        name: "open",
        description: "Opens a lease of the sender: while it is open, any client may move the robot, and the sender keeps the lease. Refused with halted during a halt and with not_leased when the sender holds no lease of the robot.",
        request_message_format: { robot: "string" },
        failure_kinds: ["halted", "not_leased"],
      },
      {
        name: "close",
        description: "Closes a lease of the sender that it opened. Refused with not_leased when the sender holds no lease of the robot.",
        request_message_format: { robot: "string" },
        failure_kinds: ["not_leased"],
      },
      {
        name: "check_move",
        description: "Whether the sender may move a robot or change the state of a device, before a call of a member with the mark moves_robot: on the robot of the instance that it calls, or on a robot of the listing by its name. Exactly one of instance and robot is given. During a halt it refuses every call. On an instance outside any copy it allows every call. Otherwise it allows any client on a robot whose lease is open, a lease holder on the robots that it leases, and a client that is not a lease holder on a robot with no lease. A refusal gives the failure kind and the message that the client refuses its call with. While a goal on such a member runs, the client cancels it at a halt that `changes` gives under a later revision than the answer.",
        request_message_format: {
          instance: { $type: "string", $optional: true },
          robot: { $type: "string", $optional: true },
        },
        response_message_format: {
          refusal: {
            $type: "object",
            $optional: true,
            $description: "Absent when the client may move the robot.",
            failure_kind: { $type: "string", $enum: ["halted", "leased", "not_leased"] },
            message: "string",
          },
          revision: { $type: "u64", $description: "The revision of the fleet that the answer reads." },
        },
      },
      {
        name: "halt",
        description: "Halts the stack, with no wait for the clients: the daemon ends every lease with no give-back, refuses every lease and every move until clear_halt, and then writes the halt to disk, so it stays after a restart of the daemon. Each lease holder, MCP server and `peppy node call` cancels its goals on members with the mark moves_robot. A halt that the daemon does not write to disk holds all the same, and the call fails with attempt_failed: that halt ends at a restart of the daemon, and a next halt writes it again. A second halt changes nothing else.",
      },
      {
        name: "clear_halt",
        description: "Ends the halt. It starts nothing again: each client takes its leases again. Without a halt it changes nothing. Refused with attempt_failed when the daemon cannot remove the halt from disk: the stack then stays halted.",
      },
    ],
    actions: [
      {
        name: "changes",
        description: "Follows the fleet: the first feedback gives the listing, and each next feedback one change, in order, with the listing after it. The goal runs until its client cancels it. Each MCP server of peppy can call it with no scope.",
        feedback_topic: {
          qos_profile: "reliable",
          message_format: {
            change: {
              $type: "string",
              $enum: [
                "listing",
                "join",
                "removal",
                "software_stop",
                "software_start",
                "lease_start",
                "lease_end",
                "lease_open",
                "lease_close",
                "offer_start",
                "offer_end",
                "holder_change",
                "halt_start",
                "halt_end",
              ],
            },
            robot: { $type: "string", $description: "The robot of the change; empty for listing, halt_start and halt_end." },
            revision: { $type: "u64", $description: "The revision of the fleet that the change made; for listing, the revision of the listing." },
            listing: {
              $type: "object",
              $description: "The fleet listing after the change, as `list` gives it.",
              version: "string",
              core_node: "string",
              launcher: "string",
              halted: "bool",
              halted_by: "string",
              robots: {
                $type: "array",
                $items: {
                  $type: "object",
                  name: "string",
                  option: "string",
                  core_node: "string",
                  kind: { $type: "string", $enum: ["simulated", "physical"] },
                  clock: "string",
                  software: { $type: "string", $enum: ["running", "stopped"] },
                  robot_commander: "string",
                  instances: {
                    $type: "array",
                    $items: {
                      $type: "object",
                      name: "string",
                      instance: "string",
                      core_node: "string",
                      node: "string",
                      node_tag: "string",
                    },
                  },
                  contracts: {
                    $type: "array",
                    $items: {
                      $type: "object",
                      name: "string",
                      tag: "string",
                      sha256: "string",
                      instances: { $type: "array", $items: "string" },
                    },
                  },
                },
              },
              leases: {
                $type: "array",
                $items: {
                  $type: "object",
                  robot: "string",
                  holder: "string",
                  holder_core_node: "string",
                  name: "string",
                  open: "bool",
                  giver: "string",
                  giver_core_node: "string",
                  receiver: "string",
                  receiver_core_node: "string",
                },
              },
              options: {
                $type: "array",
                $items: {
                  $type: "object",
                  option: "string",
                  kind: { $type: "string", $enum: ["simulated", "physical"] },
                  contracts: {
                    $type: "array",
                    $items: { $type: "object", name: "string", tag: "string", sha256: "string" },
                  },
                  features: {
                    $type: "array",
                    $items: {
                      $type: "object",
                      feature: "string",
                      contracts: {
                        $type: "array",
                        $items: { $type: "object", name: "string", tag: "string", sha256: "string" },
                      },
                    },
                  },
                },
              },
              documents: {
                $type: "array",
                $items: {
                  $type: "object",
                  name: "string",
                  tag: "string",
                  sha256: "string",
                  document: "string",
                },
              },
              nodes: {
                $type: "array",
                $items: {
                  $type: "object",
                  name: "string",
                  tag: "string",
                  machines: {
                    $type: "array",
                    $items: {
                      $type: "object",
                      core_node: "string",
                      manifest_sha256: "string",
                      commit: "string",
                    },
                  },
                  instances: {
                    $type: "array",
                    $items: {
                      $type: "object",
                      instance: "string",
                      core_node: "string",
                      robot: "string",
                    },
                  },
                },
              },
            },
          },
        },
      },
      {
        name: "lease",
        description: "The goal of a lease holder: while it runs, its sender holds leases. Its feedback gives each offer to the sender and each end of an offer to it, and each end or give-back of a lease of the sender. The goal runs until its client cancels it or is gone; then every lease of the sender ends or goes back to its giver. Refused with precondition_failed while another `lease` goal of the same process runs. A new `lease` goal of a restarted process ends the goal of the process before it.",
        feedback_topic: {
          qos_profile: "reliable",
          message_format: {
            event: {
              $type: "string",
              $enum: ["offer", "offer_end", "lease_end", "lease_back"],
            },
            robot: "string",
            giver: { $type: "string", $description: "The giver of an offer or of a lease that came back, and its machine; empty for the end of a lease that the sender took." },
            giver_core_node: "string",
            cause: { $type: "string", $description: "Why the offer or the lease ended, or came back." },
          },
        },
      },
    ],
  },
}
