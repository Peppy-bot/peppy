def create_node():
    """Creates a new {{ name }} node"""
    return struct(
        namespace = "/",
        # Quality of Service settings
        qos_profile = "normal",

        # Logging configuration
        logging = struct(
            level = "info",
            to_file = False,
        ),

        # Node parameters
        parameters = struct(),
    )

# Export for use by other modules
exported = struct(
    node = create_node()
)