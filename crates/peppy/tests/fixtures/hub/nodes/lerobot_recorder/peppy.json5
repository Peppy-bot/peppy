{
  peppy_schema: "node/v1",
  manifest: {
    name: "lerobot_recorder",
    tag: "v1",
    labels: ["recorder"]
  },
  execution: {
    language: "rust",
    run_cmd: ["./bin/lerobot_recorder"]
  },
  interfaces: {
    actions: {
      exposes: [
        {
          // One dataset episode per goal: a task description in the request, a
          // running frame count as feedback, and the episode id in the result.
          name: "record_episode",
          goal_service: {
            request_message_format: {
              task_description: "string"
            }
          },
          feedback_topic: {
            message_format: {
              frames_recorded: "u64"
            }
          },
          result_service: {
            response_message_format: {
              episode_id: "u32",
              frames_recorded: "u64"
            }
          }
        }
      ]
    },
    services: {
      exposes: [
        {
          // Takes no request; the response carries the number of episodes
          // recorded.
          name: "finish_session",
          response_message_format: {
            episodes_recorded: "u32"
          }
        }
      ]
    }
  }
}
