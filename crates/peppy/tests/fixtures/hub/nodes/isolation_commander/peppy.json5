{
  peppy_schema: "node/v1",
  manifest: {
    name: "isolation_commander",
    tag: "v1",
    depends_on: {
      nodes: [
        { name: "isolation_arm", tag: "v1", link_id: "arm" }
      ]
    },
    labels: ["commander"]
  },
  execution: {
    language: "python",
    build_cmd: ["uv", "sync", "--no-editable"],
    run_cmd: ["./.venv/bin/python", "-m", "isolation_commander"],
    parameters: {
      // Prefixes every token this commander sends, so the payloads of one
      // copy are told apart from another's in the arm's log.
      label: { $type: "string", $default: "unlabeled" }
    }
  },
  interfaces: {
    topics: {
      consumes: [
        { link_id: "arm", name: "heartbeat" }
      ]
    },
    services: {
      consumes: [
        { link_id: "arm", name: "echo" },
        { link_id: "arm", name: "release" }
      ],
      exposes: [
        {
          // Moves the held goal on: `cancel` cancels it, `release` lets the
          // arm complete it. Answers with the token of the goal it moved on.
          name: "move_on",
          request_message_format: { verb: "string" },
          response_message_format: { token: "string" }
        }
      ]
    },
    actions: {
      consumes: [
        { link_id: "arm", name: "move" }
      ]
    }
  }
}
