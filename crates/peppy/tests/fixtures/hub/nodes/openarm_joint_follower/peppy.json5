{
  peppy_schema: "node/v1",
  manifest: {
    name: "openarm_joint_follower",
    tag: "v1",
    depends_on: {
      // One limb of a teleoperated pair, playing the `follower` role of
      // `joint_link/v1` through its single participant slot.
      pairings: [
        { name: "joint_link", tag: "v1", role: "follower", link_id: "limb" }
      ]
    },
    labels: ["follower"]
  },
  execution: {
    language: "rust",
    run_cmd: ["./bin/openarm_joint_follower"]
  },
  interfaces: {
    topics: {
      emits: [
        { link_id: "limb", name: "joint_states" }
      ],
      consumes: [
        { link_id: "limb", name: "joint_setpoints" }
      ]
    }
  }
}
