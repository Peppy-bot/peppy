{
  peppy_schema: "contract/v1",
  manifest: {
    name: "openarm_governor_control",
    tag: "v1"
  },
  // Runtime on/off for the backbone's self-collision governor. A contract
  // rather than a node dependency because whoever drives the governor is a UI
  // decision: the operator panel implements it here, and a scripted routine
  // could implement it instead without the backbone changing.
  interfaces: {
    topics: [
      {
        name: "governor_control",
        // Re-published periodically and lossy: a dropped toggle cannot strand
        // the backbone in the wrong mode, because the next tick corrects it.
        qos_profile: "sensor_data",
        message_format: {
          stamp: "time",
          collision_governor_enabled: "bool"
        }
      }
    ]
  }
}
