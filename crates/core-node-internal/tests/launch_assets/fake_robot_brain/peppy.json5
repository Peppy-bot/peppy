{
  schema_version: 1,
  manifest: {
    // This is a brain that can plug to any controller
    name: "fake_robot_brain",
    tag: "0.1.0",
    labels: [
      "brain"
    ],
    depends_on: {
      nodes: [
        { name: "fake_uvc_camera", tag: "0.1.0", local_id: "fake_uvc_camera" },
        { name: "fake_openarm01_controller", tag: "0.1.0", local_id: "fake_openarm01_controller" },
      ]
    },
  },
  runtime: {
    language: "rust",
    add_cmd: [
      "true"
    ],
    start_cmd: [
      "sleep",
      "60"
    ]
  },
  interfaces: {
    // The brain receives the inputs from the camera
    topics: {
      emits: [],
      consumes: [
        {
          local_node_id: "fake_uvc_camera",
          name: "video_stream",
        }
      ],
    },
    services: {
      exposes: [],
      consumes: [
        {
          local_node_id: "fake_uvc_camera",
          name: "video_stream_info",
        }
      ],
    },
    // And emit actions for the controller to take
    actions: {
      exposes: [],
      consumes: [
        {
          local_node_id: "fake_openarm01_controller",
          name: "move_right_arm",
        },
        {
          local_node_id: "fake_openarm01_controller",
          name: "move_left_arm",
        }
      ],
    },
  }
}