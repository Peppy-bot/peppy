{
  peppy_schema: "node_v1",
  manifest: {
    // This is a brain that can plug to any controller
    name: "fake_robot_brain",
    tag: "v1",
    labels: [
      "brain"
    ],
    depends_on: {
      nodes: [
        {
          name: "fake_uvc_camera",
          tag: "v1",
          link_id: "fake_uvc_camera"
        },
        {
          name: "fake_openarm01_controller",
          tag: "v1",
          link_id: "fake_openarm01_controller"
        },
      ]
    },
  },
  interfaces: {
    // The brain receives the inputs from the camera
    topics: {
      emits: [],
      consumes: [
        {
          link_id: "fake_uvc_camera",
          name: "video_stream",
        }
      ],
    },
    services: {
      exposes: [],
      consumes: [
        {
          link_id: "fake_uvc_camera",
          name: "video_stream_info",
        }
      ],
    },
    // And emit actions for the controller to take
    actions: {
      exposes: [],
      consumes: [
        {
          link_id: "fake_openarm01_controller",
          name: "move_right_arm",
        },
        {
          link_id: "fake_openarm01_controller",
          name: "move_left_arm",
        }
      ],
    },
  },
  execution: {
    language: "rust",
    build_cmd: [
      "true"
    ],
    run_cmd: [
      "sleep",
      "60"
    ]
  },
}