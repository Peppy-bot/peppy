{
  schema_version: 1,
  manifest: {
    // This is a brain that can plug to any controller
    name: "fake_robot_brain",
    tag: "0.1.0",
    language: "rust",
    labels: [
      "brain"
    ],
  },
  process: {
    add_cmd: [
      "true"
    ],
    start_cmd: [
      "sleep",
      "60"
    ]
  },
  parameters: {},
  interfaces: {
    // The brain receives the inputs from the camera
    topics: {
      emits: [],
      expects: [
        {
          id: "camera_front",
          node: "fake_uvc_camera",
          name: "video_stream",
          tag: "0.1.0",
        }
      ],
    },
    services: {
      exposes: [],
      consumes: [
        {
          id: "video_info",
          node: "fake_uvc_camera",
          name: "video_stream_info",
          tag: "0.1.0",
        }
      ],
    },
    // And emit actions for the controller to take
    actions: {
      exposes: [],
      consumes: [
        {
          id: "move_right_arm_action",
          node: "fake_openarm01_controller",
          name: "move_right_arm",
          tag: "0.1.0",
        },
        {
          id: "move_left_arm_action",
          node: "fake_openarm01_controller",
          name: "move_left_arm",
          tag: "0.1.0",
        }
      ],
    },
  }
}