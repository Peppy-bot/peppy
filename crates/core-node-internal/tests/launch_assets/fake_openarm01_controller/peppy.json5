{
  schema_version: 1,
  manifest: {
    name: "fake_openarm01_controller",
    tag: "0.1.0",
    labels: [
      "controller",
      "openarm"
    ],
  },
  runtime: {
    language: "rust",
    add_cmd: [
      "true"
    ],
    start_cmd: [
      "sleep",
      "60"
    ]
  },
  interfaces: {
    topics: {
      emits: [],
      consumes: [],
    },
    services: {
      exposes: [],
      consumes: [],
    },
    actions: {
      exposes: [
        {
          name: "move_right_arm",
          goal_service: {
            request_message_format: {
              arm_id: "u16",
              // x, y, z
              desired_position: {
                $type: "array",
                $items: "i32",
                $length: 3
              }
            },
            response_message_format: {
              accepted: "bool"
            }
          },
          feedback_topic: {
            qos_profile: "standard",
            message_format: {
              current_position: {
                $type: "array",
                $items: "i32",
                $length: 3
              }
            }
          },
          result_service: {
            response_message_format: {
              final_position: {
                $type: "array",
                $items: "i32",
                $length: 3
              }
            }
          }
        },
        {
          name: "move_left_arm",
          goal_service: {
            request_message_format: {
              arm_id: "u16",
              // x, y, z
              desired_position: {
                $type: "array",
                $items: "i32",
                $length: 3
              }
            },
            response_message_format: {
              accepted: "bool"
            }
          },
          feedback_topic: {
            qos_profile: "standard",
            message_format: {
              current_position: {
                $type: "array",
                $items: "i32",
                $length: 3
              }
            }
          },
          result_service: {
            response_message_format: {
              final_position: {
                $type: "array",
                $items: "i32",
                $length: 3
              }
            }
          }
        }
      ],
      consumes: [],
    },
  }
}