{
  peppy_schema: "launcher/v1",
  deployments: [
    {
      source: {
        name: "fake_robot_brain:v1"
      },
      instances: [
        {
          instance_id: "the_brain",
          arguments: {},
          links: {
            front_camera: "camera_front",
            robot_controller: "the_nervous_system",
          },
        }
      ],
    },
    {
      source: {
        name: "fake_openarm01_controller:v1",
      },
      instances: [
        {
          instance_id: "the_nervous_system",
          arguments: {}
        }
      ]
    },
    {
      source: {
        name: "fake_uvc_camera:v1",
      },
      instances: [
        {
          instance_id: "camera_front",
          arguments: {
            device_path: "/dev/video_right",
            video: {
              frame_rate: 30,
              resolution: {
                width: 1920,
                height: 1080,
              },
              encoding: "yuyv",
            },
          }
        },
        {
          instance_id: "camera_rear",
          arguments: {
            device_path: "/dev/video_left",
            video: {
              frame_rate: 30,
              resolution: {
                width: 1920,
                height: 1080,
              },
              encoding: "yuyv",
            },
          }
        }
      ]
    }
  ]
}