[project]
name = "peppygen"
version = "0.1.0"
requires-python = ">= 3.11"
dependencies = ["peppylib", "pycapnp"]

[tool.uv.sources]
peppylib = { path = "{{ peppylib_path }}" }

[tool.setuptools.packages.find]
include = ["peppygen*"]

[tool.setuptools.package-data]
peppygen = ["capnp/*.capnp"]

[tool.ruff]
exclude = ["crates"]

[tool.ruff.lint.per-file-ignores]
"__init__.py" = ["F401"]
