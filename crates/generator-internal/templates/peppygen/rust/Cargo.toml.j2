[package]
name = "peppygen"
version = "0.1.0"
edition = "2024"

[dependencies]
tokio = { version = "1", features = ["full"] }
# This should be the only peppy dependency peppygen depends on
peppylib = { path = "{{ peppylib_path }}", version = "{{ peppylib_version }}" }
# `unaligned`: the generated deserializers read messages in place from the
# transport's buffer, which carries no alignment guarantee.
capnp = { version = "0.27", features = ["unaligned"] }
bytes = "1"
thiserror = "2.0"
serde = "1.0"
schemars = "1.2"

[features]
# Enable from the node's [dev-dependencies] only: unlocks the generated
# `mock` and `fixtures` modules (cargo build never resolves dev-deps, so
# production binaries can never contain them).
testing = ["peppylib/testing"]
