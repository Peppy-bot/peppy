[project]
name = "peppylib"
version = "{{ peppylib_version }}"
description = "The Peppy control library (prebuilt, deployed by peppy)"
requires-python = ">={{ python_min_version }},<{{ python_max_version }}"
dependencies = []

[tool.setuptools.packages.find]
include = ["peppylib*"]

# `capnp_compiler`: the Cap'n Proto compiler of the codec API, which only a
# node that asks for the codec API gets.
[tool.setuptools.package-data]
peppylib = ["*.so", "capnp_compiler"]
