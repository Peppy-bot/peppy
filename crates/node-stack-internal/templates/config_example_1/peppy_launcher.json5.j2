{
  deployments: [
    {
      name: "{{ lidar_sensor_node_name }}",
      source: {
        repo: "{{ lidar_sensor_github_repo }}",
        path: "{{ lidar_sensor_github_repo_path }}"
      },
      tag: "{{ lidar_sensor_github_tag }}",
      instances: [
        {
          instance_id: "lidar_1",
          parameters: {
            device: {
              physical: "/dev/lidar1",
              sim: "mujoco:lidar1",
              priority: "sim"
            },
            lidar_point: {
              x: 12.34, // meters, X coordinate in 3D space
              y: -7.56, // meters, Y coordinate in 3D space
              z: 1.23, // meters, Z coordinate in 3D space (height)
              intensity: 0.85, // normalized intensity of return signal (0 to 1)
              return_type: 1, // e.g. 1 = first return, 2 = last return
              classification: 2, // e.g. 2 = ground, 5 = vegetation
              timestamp: 1696285145999, // Unix timestamp in milliseconds
            }
          }
        }
      ]
    },
    {
      name: "{{ uvc_camera_node_name }}",
      source: {
        repo: "{{ uvc_camera_github_repo }}",
        path: "{{ uvc_camera_github_repo_path }}"
      },
      tag: "0.1.0",
      instances: [
        {
          instance_id: "camera_right",
          parameters: {
            device: {
              physical: "/dev/video_right",
              sim: "mujoco:camera_right",
              priority: "physical"
            },
            video: {
              frame_rate: 30,
              resolution: {
                width: 1920,
                height: 1080,
              },
              encoding: "yuyv",
            },
          }
        },
        {
          instance_id: "camera_left",
          parameters: {
            device: {
              physical: "/dev/video_left",
              sim: "mujoco:camera_left",
              priority: "physical"
            },
            video: {
              frame_rate: 30,
              resolution: {
                width: 1920,
                height: 1080,
              },
              encoding: "yuyv",
            },
          }
        }
      ]
    },
    // `web_video_stream` depends on `uvc_camera`
    {
      // The test will add the web_video_stream to the local stack
      name: "{{ web_video_stream_node_name }}",
      tag: "0.1.0",
      // Since it's optional, if the node cannot be found, it will be ignored
      optional: "{{ web_video_stream_optional }}",
      instances: [
        {
          instance_id: "stream_1",
          parameters: {
            http: {
              host: "0.0.0.0",
              port: 8083,
              cors_enabled: false,
              cors_origins: "*",
              max_connections: "2000",
              request_timeout_ms: "3000",
            },
            video_stream: {
              format: "mjpeg",
              quality: 3,
              max_fps: 30,
            },
          }
        }
      ]
    },
    {
      name: "{{ brain_node_name }}",
      // The test will add the brain_node to the local stack
      tag: "0.1.0",
      instances: [
        {
          instance_id: "the_brain",
          parameters: {}
        }
      ],
      subscriber_targets: [
        {
          id: "camera_stream",
          // Subscribe to all these instances
          target_instance_ids: [
            "camera_right",
            "camera_left"
          ]
        },
      ]
    },
    {
      name: "{{ controller_node_name }}",
      // The test will add the controller_node to the local stack
      tag: "0.1.0",
      instances: [
        {
          instance_id: "the_nervous_system",
          parameters: {}
        }
      ]
    },
  ],
  logging: {
    min_level: "info",
    format: "text"
  }
}