{
  schema_version: 1,
  manifest: {
    name: "{{ node_name }}",
    tag: "{{ node_tag }}",
    labels: [
      "sensor",
      "usb",
      "lidar"
    ],
    launch_cmd: [
      "cargo",
      "run",
      "--release"
    ]
  },
  config: {
    auto_start: false,
    respawn: true,
    respawn_delay: 3.0,
  },
  parameters: {
    device: {
      physical: "string",
      sim: "string",
      priority: "string"
    }
  },
  interfaces: {
    exposes: {
      topics: [
        {
          name: "push_lidar_object",
          qos_profile: "sensor_data",
          message_format: {
            header: {
              type: "object",
              stamp: "time",
              frame_id: "u32",
            },
            x: "f32",
            y: "f32",
            z: "f32",
            intensity: "f32",
            return_type: "u8", // e.g. first return, last return
            classification: "u8", // type of object detected
          },
        }
      ],
      services: [
        {
          name: "enable_camera",
          message_format: {
            enable: "bool",
          }
        },
        {
          name: "get_camera_info",
          message_format: {
            card_type: "string",
            size: "string",
            interval: "string"
          },
        },
      ],
    },
    subscribes_to: {
      topics: [],
      services: [],
      actions: [],
    },
  },
  resources: {
    max_memory_mb: 256,
  },
  logging: {
    min_level: "info",
  }
}