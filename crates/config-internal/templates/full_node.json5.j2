{
  manifest: {
    name: "{{ name }}",
    tag: "0.1.0",
    launch_cmd: {{ launch_cmd | safe }}
  },
  config: {
    respawn: true,
    respawn_delay: 1
  },
  resources: {
    max_memory_mb: 1024
  },
  logging: {
    min_level: "info",
    file_name: "{{ log_file_name }}",
    max_file_size_mb: 10,
    format: "text"
  }
}
