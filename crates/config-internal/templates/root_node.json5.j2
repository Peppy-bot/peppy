{
  manifest: {
    name: "{{ name }}",
    version: "0.1.0"
  },
  config: {
    is_root: true,
    auto_start: true,
    respawn: true,
    respawn_delay: 1.0
  },
  instances: [
    {
      namespace: "{{ namespace }}",
      parameters: {
        status: {
          frequency: "1Hz"
        }
      }
    }
  ],
  interfaces: {
    subscribes_to: {
      topics: [
        {
          name: "{any}",
          version: "{any}",
          namespace: "/",
          type: "/peppy/status",
          callback: "on_root_node_discovered"
        }
      ],
      services: [
        {
          name: "{any}",
          version: "{any}",
          namespace: "/",
          type: "/peppy/node",
          callback: "on_payload_node_received"
        }
      ]
    },
    exposes: {
      topics: [
        {
          // It's not recommended to modify this topic
          type: "/peppy/status",
          qos_profile: "standard",
          message_format: {
            name: "str"
          }
        }
      ],
      services: [
        {
          // It's not recommended to modify this service
          type: "/peppy/node",
          qos_profile: "standard",
          message_format: {
            payload: "bytes"
          }
        }
      ],
      actions: []
    }
  },
  resources: {
    max_memory_mb: 1024
  },
  logging: {
    min_level: "info",
    // ${LOGS_ROOT_DIR} is `.peppy/logs/` in dev mode and `/var/log/peppy/` (empty) in production
    file_path: "${LOGS_ROOT_DIR}/{{ log_file_name }}",
    max_file_size_mb: 100,
    format: "text"
  }
}
