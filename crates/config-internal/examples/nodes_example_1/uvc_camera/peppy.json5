// A simple node that emits video frames from a UVC camera
{
  schema_version: 1,
  manifest: {
    name: "uvc_camera",
    tag: "0.1.0",
    // Labels are useful if the node is published with `peppy node publish`
    labels: [
      "uvc",
      "camera",
      "usb",
    ],
  },
  runtime: {
    language: "rust",
    container: {
      def_file: "apptainer.def"
    }
  },
  // Expected parameter types to start the node
  parameters: {
    device: {
      // Can be USB IDs/serial or udev rule
      physical: "string", // values like `/dev/video4` or `/dev/video_front`
      sim: "string", // values like `mujoco:camera_front` or `isaac_sim:camera_rear`
      priority: "string" // "physical" or "sim". If the physical path is not accessible, the sim path is attempted
    },
    video: {
      frame_rate: "u16",
      resolution: {
        width: "u16",
        height: "u16",
      },
      encoding: "string", // "rgb8", "bgr8", "yuyv", "mjpeg"
    },
  },
  interfaces: {
    topics: {
      emits: [
        {
          name: "video_stream",
          qos_profile: "sensor_data",
          message_format: {
            header: {
              $type: "object",
              stamp: "time",
              frame_id: "u32",
            },
            encoding: "string", // "rgb8", "bgr8", "yuyv", "mjpeg"
            width: "u32",
            height: "u32",
            frame: {
              $type: "array",
              $items: "u8",
            },
          },
        }
      ],
    },
    services: {
      exposes: [
        {
          name: "enable_camera",
          request_message_format: {
            enable: "bool",
          },
        },
        {
          // This service simply returns camera info; no request body is required.
          name: "video_stream_info",
          response_message_format: {
            width: "u32",
            height: "u32",
            frames_per_second: "u8",
            encoding: "string",
          },
        },
      ],
    },
  }
}