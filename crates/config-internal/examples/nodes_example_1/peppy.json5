// PeppyOS Root Node Configuration
// This is the main configuration file that defines the root node of the current machine.
// It's run using the `peppy serve` command. It will automatically use the `peppy.json5` file in the same path the command is run as the root configuration file and will look into child folders for other `peppy.json5` files for children nodes.
// Any new node that is created should be added to the root_node by running the command `peppy node add <path_to_peppy.json5>`
// There is only one root node/service per machine/OS and they automatically discover the other root nodes that are on the same network running on different computers
// This configuration is created with `peppy init`, the `peppy serve` command cannot run without it.
{
  manifest: {
    // `name` can only have alphanumeric, underscore, or hyphen characters.
    name: "my_robot_1", // It's a good practice to give a unique name to the root node to avoid name conflicts with other root nodes under the same network
    tag: "0.1.0",
    labels: [
      "root_node",
      "my_robot_1"
    ],
    // When `is_root_node` is `true`, the following fields are fobidden:
    // - `manifest.launch_cmd`: This command has no relevance in the root node
    // While those fields are only allowed in the root node:
    // - `deployments`: Defines how to start the starting node graph
    is_root_node: true
  },
  config: {
    auto_start: true, // Always true for the root node
    respawn: true, // Always true for the root node
    // Always restart the root node if it crashes
    respawn_delay: 1.0 // In seconds. Only relevant when the node is installed as a `systemd` service with `peppy node deploy`
  },
  // - `deployments` pulls those nodes from nodes.peppy.bot and store/use them in/from the .peppy directory if they are not present in the children directory relative to this configuration file.
  // - `deployments` adopts a "value specification syntax" in opposition to the "declarative syntax" present in the other config files
  // - `deployments` in the future can eventually start nodes on MCUs 
  deployments: [
    // In this example, 2 intances of uvc_camera will be deployed, both instances will emit to a single `web_video_stream` instance
    {
      // This is an example of pulling the `uvc_camera` node from github and instanciating it with user defined parameters. In the future we might be able to pull them from nodes.peppy.bot
      name: "uvc_camera",
      // Can be a github repo, an http url like `https://nodes.peppy.bot/uvc_camera` or a filesystem uri
      // Can also be a simple string "https://github.com/Peppy/uvc_camera.git". If that's the case, the root path of the repo will be used as the node
      source: {
        repo: "https://github.com/Peppy/nodes.git",
        path: "uvc_camera"
      },
      tag: "0.1.0", // In that example the tag is a git tag
      instances: [
        {
          namespace: "/camera/right",
          parameters: {
            device: {
              physical: "/dev/video_right",
              sim: "mujoco:camera_right",
              priority: "physical" // "physical" or "sim". If the physical path is not accessible, the sim path is attempted
            },
            video: {
              frame_rate: 30,
              resolution: {
                width: 1920,
                height: 1080,
              },
              encoding: "yuyv", // "rgb8", "bgr8", "yuyv", "mjpeg"
            },
          }
        },
        {
          namespace: "/camera/left",
          parameters: {
            device: {
              physical: "/dev/video_left",
              sim: "mujoco:camera_left",
              priority: "physical" // "physical" or "sim". If the physical path is not accessible, the sim path is attempted
            },
            video: {
              frame_rate: 30,
              resolution: {
                width: 1920,
                height: 1080,
              },
              encoding: "yuyv", // "rgb8", "bgr8", "yuyv", "mjpeg"
            },
          }
        }
      ]
    },
    {
      name: "web_video_stream",
      // If `source` is not specified, the node will be searched inside the node stack of the running `peppy` daemon
      tag: "0.1.0",
      optional: true, // false by default. If set to `false`, do not prevent `peppy serve` from starting if the node cannot be found in the node stack
      instances: [
        {
          namespace: "/camera/stream/right",
          parameters: {
            http: {
              host: "0.0.0.0",
              port: 8083,
              cors_enabled: false,
              cors_origins: "*",
              max_connections: "2000",
              request_timeout_ms: "3000",
            },
            video_stream: {
              format: "mjpeg",
              quality: 3,
              max_fps: 30,
            },
          }
        }
      ]
    },
  ],
  interfaces: {
    subscribes_to: {
      topics: [
        // This topic discovers other root nodes on the same network, in the same namespace
        {
          node: "{any}", // Will look for any node
          tag: "{any}", // On any version/tag
          name: "peppy_node_status", // That publishes its status on that topic
          callback: "on_root_node_discovered" // The callback that is called when a node is discovered
        }
      ],
      services: [
        // Subscribe to other root nodes on the same network
        {
          node: "{any}", // Will look for any node
          tag: "{any}", // On any version/tag
          name: "peppy_node_status", // That publishes its status on that topic
          callback: "on_payload_node_received" // The callback that is called when a node sends its payload
        }
      ]
    },
    exposes: {
      topics: [
        // Exposes its status for other root nodes on the same network to discover
        {
          name: "peppy_node_status",
          qos_profile: "standard", // Options: "standard", "reliable", "sensor_data"
          message_format: {
            name: "str"
          }
        }
      ],
      services: [
        // Exposes its node status including:
        //  - Its name & configuration
        //  - The node list
        //  - etc..
        // This allows another node such as `peppy_rest_api` to aggregate root nodes statuses
        // It also allow root nodes on the same network to discover each other and their content.
        {
          name: "peppy_node_status",
          qos_profile: "standard",
          message_format: {
            // Use that message format if the payload is subject to change
            payload: "bytes"
          }
        }
      ],
      actions: []
    }
  },
  resources: {
    max_memory_mb: 1024
  },
  logging: {
    min_level: "info",
    // Will be stored in `.peppy/logs/peppy_root.log` in dev mode and `/var/log/peppy/peppy_root.log` in production
    file_name: "peppy_root.log",
    max_file_size_mb: 100,
    format: "text"
  }
}