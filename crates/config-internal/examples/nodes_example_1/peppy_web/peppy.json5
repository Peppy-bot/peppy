// Connects to root nodes and aggregate their content in a web interface
{
  manifest: {
    name: "peppy_web",
    tag: "0.1.0",
    labels: [
      "peppy",
      "REST",
      "backend",
    ],
    language: "rust"
    // sha256: "8e115d5f9208ef16cc49e32d88cd3efce839c9c11688c474069ba43023efdd5f" Usually only specified for nodes that are pulled from nodes.peppy.bot
  },
  config: {
    auto_start: true,
    respawn: true,
    respawn_delay: 2.0,
    startup_type: "fork", // Optional: Uses "thread" by default, "fork" uses more resources but ensures that in the event of the root node crash, the current node doesn't crash along with it.
  },
  parameters: {
    http: {
      host: "string",
      port: "u16",
      max_connections: "u32",
      request_timeout_ms: "u32",
    },
  },
  interfaces: {
    // This node does not expose anything for other nodes. It exposes a REST API
    // to the end user but that is outside of the realm of node-to-node communication
    exposes: {
      topics: [],
      services: [],
      actions: [],
    },
    subscribes_to: {
      topics: [
        {
          // Subscribes to the current root_node status but also any node that
          // emits to `/<dev or prod>/peppy_node_status`
          node: "{any}",
          tag: "{any}", // Any tag/version will do
          name: "peppy_node_status",
          callback: "on_node_status_received", // Auto exposed callback in code
          optional: true, // In strict mode, do not prevent this node from starting if emitters are not found
        },
      ],
      services: [
        {
          node: "{any}",
          tag: "{any}", // Any tag/version will do
          name: "peppy_node_status",
          callback: "on_node_payload_received",
          optional: true, // Same optional behavior as topics
        },
      ],
    },
  },
  resources: {
    max_memory_mb: 512,
  },
  logging: {
    min_level: "info",
  },
}