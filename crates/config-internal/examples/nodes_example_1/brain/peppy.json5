// A simple node that has an AI and acts as the brain of the robot
// It sends actions to the controller to perform those actions
{
  schema_version: 1,
  manifest: {
    name: "my_action_robot_brain",
    tag: "0.1.0",
    language: "rust",
    labels: [
      "brain"
    ],
    // Eventually in the future if we want to use a container-like technology like apptainer or create WASM binary
    // container: {
    //   image_file: "./Dockerfile",
    //   resources: {
    //     max_memory_mb: 512,
    //   },
    // },
    start_cmd: [
      "cargo",
      "run",
      "--release"
    ]
  },
  parameters: {},
  interfaces: {
    exposes: {
      topics: [],
      services: [],
      actions: [],
    },
    subscribes_to: {
      topics: [],
      services: [],
      actions: [
        {
          id: "move_right_arm_action",
          node: "my_action_robot_controller", // Will look for that node name
          name: "move_right_arm", // With this action name
          tag: "0.1.0", // On that particular tag/version
        }
      ]
    },
  }
}