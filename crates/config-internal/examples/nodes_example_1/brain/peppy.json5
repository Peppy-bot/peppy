// A simple node that has an AI and acts as the brain of the robot.
// It receives camera data and sends actions to the controller.
{
  schema_version: 1,
  manifest: {
    name: "brain",
    tag: "0.1.0",
    language: "rust",
    labels: [
      "brain"
    ],
  },
  process: {
    add_cmd: [
      "cargo",
      "build",
      "--release"
    ],
    start_cmd: [
      "./target/release/brain"
    ]
  },
  parameters: {},
  interfaces: {
    exposes: {
      topics: [],
      services: [],
      actions: [],
    },
    consumes: {
      topics: [
        {
          id: "camera_stream",
          node: "uvc_camera",
          name: "video_stream",
          tag: "0.1.0",
        }
      ],
      services: [
        {
          id: "video_info",
          node: "uvc_camera",
          name: "video_stream_info",
          tag: "0.1.0",
        }
      ],
      actions: [
        {
          id: "move_right_arm_action",
          node: "controller",
          name: "move_right_arm",
          tag: "0.1.0",
        },
        {
          id: "move_left_arm_action",
          node: "controller",
          name: "move_left_arm",
          tag: "0.1.0",
        }
      ]
    },
  }
}