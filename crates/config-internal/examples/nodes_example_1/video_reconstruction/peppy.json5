// Local example that keeps the `web_video_stream` folder path but uses the current
// fake video reconstruction structure from example_nodes.
{
  schema_version: 1,
  manifest: {
    name: "video_reconstruction",
    tag: "0.1.0",
    language: "rust",
  },
  container: {
    def_file: "apptainer.def",
    mount_paths: [
      // host_path:container_path:options
      "/tmp/video_reconstruction:/tmp/video_reconstruction:rw"
    ]
  },
  parameters: {
    // How long do you want the reconstruction to be?
    video_duration_seconds: "u32"
  },
  interfaces: {
    topics: {
      consumes: [
        {
          id: "camera_stream",
          node: "uvc_camera",
          tag: "0.1.0",
          name: "video_stream",
        },
      ],
    },
    services: {
      consumes: [
        {
          id: "camera_info",
          node: "uvc_camera",
          tag: "0.1.0",
          name: "video_stream_info",
        },
      ],
    },
  }
}