// PeppyOS REST API Service Node Configuration
// This node provides a REST API interface for system interaction
// This node does not expose anything for other nodes. It exposes a web url (http://localhost:8081/video)
// to the end user but that is outside of the realm of node-to-node communication
{
  schema_version: 1,
  manifest: {
    name: "web_video_stream",
    tag: "0.1.0",
    launch_cmd: [
      "cargo",
      "run",
      "--release"
    ]
  },
  // The input parameters of the current node
  parameters: {
    cameras_namespaces: {
      type: "array",
      items: "string"
    },
    http: {
      host: "string",
      port: "u16",
      cors_enabled: "bool",
      cors_origins: "string",
      max_connections: "u32",
      request_timeout_ms: "u32",
    },
    video_stream: {
      format: "string", // example: "mjpeg"
      quality: "u16",
      max_fps: "u16",
    },
  },
  interfaces: {
    subscribes_to: {
      topics: [
        {
          node: "uvc_camera", // Will look for that node name
          tag: "0.1.0", // On that particular tag/version
          name: "stream", // With this topic name
        }
      ],
    },
    exposes: {
      topics: [],
      services: [],
      actions: [],
    },
  },
  resources: {
    max_memory_mb: 512,
  },
  logging: {
    min_level: "info",
    file_name: "rest_api.log",
    max_file_size_mb: 100,
    format: "text",
  }
}