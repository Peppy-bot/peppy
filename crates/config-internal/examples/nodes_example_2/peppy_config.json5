// PeppyOS Root Node Configuration
{
  deployments: [
    {
      name: "my_action_robot_brain",
      source: "file://tmp/my_action_robot_brain/peppy.json5",
      tag: "0.1.0",
      optional: false, // false by default
      instances: [
        {
          namespace: "/",
          parameters: {}
        }
      ],
    },
    {
      name: "my_action_robot_controller",
      // If `source` is not specified, the node will be searched inside the node stack of the running `peppy` daemon
      tag: "0.1.0",
      instances: [
        {
          namespace: "/",
          parameters: {}
        }
      ]
    }
  ],
  interfaces: {
    subscribes_to: {
      topics: [
        {
          node: "{any}",
          tag: "{any}",
          name: "peppy_node_status",
          callback: "on_root_node_discovered"
        }
      ],
      services: [
        {
          node: "{any}",
          tag: "{any}",
          name: "peppy_node_status",
          callback: "on_payload_node_received"
        }
      ]
    },
    exposes: {
      topics: [
        {
          name: "peppy_node_status",
          qos_profile: "standard",
          message_format: {
            name: "str"
          }
        }
      ],
      services: [
        {
          name: "peppy_node_status",
          qos_profile: "standard",
          message_format: {
            payload: "bytes"
          }
        }
      ],
      actions: []
    }
  },
  logging: {
    min_level: "info",
    file_name: "peppy_root.log",
    max_file_size_mb: 100,
    format: "text"
  }
}