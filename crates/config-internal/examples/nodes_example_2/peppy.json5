// PeppyOS Root Node Configuration
{
  manifest: {
    name: "my_action_robot",
    tag: "0.1.0",
    language: "rust",
    labels: [
      "root_node",
      "my_action_robot"
    ]
  },
  config: {
    auto_start: true,
    respawn: true,
    respawn_delay: 1.0
  },
  deployments: [
    {
      name: "my_action_robot_brain",
      source: "<local>",
      tag: "0.1.0",
      instances: [
        {}
      ],
    },
    {
      name: "my_action_robot_controller",
      source: "<local>",
      tag: "0.1.0",
      instances: [
        {}
      ]
    }
  ],
  interfaces: {
    subscribes_to: {
      topics: [
        {
          node: "{any}",
          tag: "{any}",
          name: "peppy_node_status",
          callback: "on_root_node_discovered"
        }
      ],
      services: [
        {
          node: "{any}",
          tag: "{any}",
          name: "peppy_node_status",
          callback: "on_payload_node_received"
        }
      ]
    },
    exposes: {
      topics: [
        {
          name: "peppy_node_status",
          qos_profile: "standard",
          message_format: {
            name: "str"
          }
        }
      ],
      services: [
        {
          name: "peppy_node_status",
          qos_profile: "standard",
          message_format: {
            payload: "bytes"
          }
        }
      ],
      actions: []
    }
  },
  resources: {
    max_memory_mb: 1024
  },
  logging: {
    min_level: "info",
    file_name: "peppy_root.log",
    max_file_size_mb: 100,
    format: "text"
  }
}