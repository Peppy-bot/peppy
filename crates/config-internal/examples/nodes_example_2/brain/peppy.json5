// A simple node that has an AI and acts as the brain of the robot
// It sends actions to the controller to perform those actions
{
  schema_version: 1,
  manifest: {
    name: "my_action_robot_brain",
    tag: "0.1.0",
    labels: [
      "brain"
    ],
    launch_cmd: [
      "cargo",
      "run",
      "--release"
    ]
  },
  config: {
    auto_start: false,
    respawn: true,
    respawn_delay: 3.0,
  },
  parameters: {},
  interfaces: {
    exposes: {
      topics: [],
      services: [],
      actions: [],
    },
    subscribes_to: {
      topics: [],
      services: [],
      actions: [
        {
          node: "my_action_robot_controller", // Will look for that node name
          tag: "0.1.0", // On that particular tag/version
          name: "move_right_arm", // With this action name
          feedback_callback: "on_move_arm_feedback_received",
          results_callback: "on_result_callback_received"
        }
      ],
    },
  },
  resources: {
    // This is the resource per instance
    max_memory_mb: 256,
  },
  logging: {
    min_level: "info",
  }
}